# Read by shfmt (via --apply-ignore) and by editors. The shell settings here are
# the ones the gate enforces: shfmt takes its indent from this file, so changing
# a value reformats mise-tasks/ and tests/*.bats on the next `mise run fmt`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Tabs, because a tab is what shfmt writes when no width is set, and a shell
# heredoc indented with spaces is not the same program as one indented with
# tabs (<<- strips tabs only).
[{mise-tasks/*,*.sh,*.bash,*.bats}]
indent_style = tab

[*.{rs,toml,md,json,yml,yaml,pkl}]
indent_style = space
indent_size = 2

# rustfmt owns Rust and uses 4; stated here so an editor does not fight it.
[*.rs]
indent_size = 4

# Generated by release-plz.
[CHANGELOG.md]
trim_trailing_whitespace = false
