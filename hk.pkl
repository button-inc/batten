// Git hooks for this repository, run by hk (https://hk.jdx.dev) — a single Rust
// binary provisioned through mise (see mise.toml), no Node.js involved.
//
// Steps come from hk's own `Builtins` wherever one exists: upstream already
// encodes the file selectors, batching, shebang detection and fix/check split
// for these tools, and each builtin ships with its own tests. Repo-specific
// steps — the gates that exist only here — are written out below. Where a
// builtin's command needs our stricter flags, the command is overridden and
// nothing else, so the selector logic still comes from upstream.
//
// Activation is per-clone and manual — creating this file does nothing until:
//   hk install
// is run once (see CONTRIBUTING.md). hk stores the hooks in .git/hooks.
amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

// The gate, defined once and shared by two hooks:
//   - `pre-commit` runs it in fix mode on the way into a commit (stashes, applies
//     the fixers).
//   - `check` runs it in check-only mode; CI drives it via `mise run hooks`
//     (`hk check --all`) so the exact hook config is exercised on CI too, not
//     just locally. If a step is misconfigured here, CI catches it.
// clippy and the test build are both whole-workspace cargo compiles. Chaining
// cargo-fmt -> cargo-clippy -> test keeps exactly one cargo build holding the
// target-dir lock at a time: parallel steps would only serialize on that lock
// while oversubscribing the CPU. Each step also reads the formatted, then
// linted, tree.
local gate = new Mapping<String, Step> {
  // --- repo-specific gates (no upstream builtin exists) ---------------------

  // Enforces the "revisit hk config" reminder as a runnable gate, not prose:
  // fails if hk's pinned version drifts between mise.toml and this file's
  // `amends` URL. Fires on any change to either file — which includes every
  // hk version bump, the moment to re-check this config (see AGENTS.md).
  ["hk-version"] {
    glob = List("hk.pkl", "mise.toml")
    check = "mise run hk-version"
  }
  // CI installs a narrow, per-job tool set instead of the whole toolchain
  // (ci.yml, install_args). That is worth ~10s per job, and its cost is a
  // second place tool names are written down. `mise install` does not fail on
  // an unknown name, so drift between the two files surfaces late as "command
  // not found". This is that rule's mechanism: the names must resolve.
  ["ci-tools-check"] {
    glob = List(".github/workflows/ci.yml", "mise.toml")
    check = "mise run ci-tools-check"
  }
  // Enforces the "research goes to Linear, not a repo docs/ tree" directive as
  // a runnable gate, not prose (see AGENTS.md): fails if any docs/ path is
  // tracked. Research deliverables and evidence notes attach to the Linear
  // issue; the repo carries code and its close-in config, not research prose.
  //
  // Deliberately keeps NO glob where its two glob-less neighbours got one
  // (CLOUD-224). Its input genuinely is the whole index: it fails on any TRACKED
  // docs/ path, including one an earlier commit left behind, so a glob would let
  // a violation persist unreported for every commit that did not touch it. It
  // costs ~95ms, which is what makes that affordable.
  ["no-docs-tree"] {
    check = "mise run no-docs-tree"
  }
  // The other half of the same non-negotiable: an adopted practice is justified
  // on this repo's terms, not by who else does it (mem:prior-art-and-issue-
  // hygiene). The task existed with its full decision table and bats suite and
  // was wired to nothing, so the rule it enforces was prose and its green suite
  // measured only itself — the shape CLOUD-242 and CLOUD-253 hit inside the
  // library, here at the task layer (CLOUD-216). No glob, like batten-check:
  // any tracked file can carry an appeal, so the scan judges the whole tree.
  ["attribution-check"] {
    check = "mise run attribution-check"
  }
  // The third half of the same non-negotiable. CONTRIBUTING.md's license table
  // ends "Confirm each _to confirm_ entry before that tool is adopted in a
  // shipped release" — a release precondition stated in prose, which nothing
  // enforced while three of five rows sat unresolved (CLOUD-325). The table
  // stays the authority; this only asserts that no row is still an open
  // question. It cannot check that a recorded license is *correct* — that is a
  // human reading an upstream LICENSE — so it proves the narrower thing an exit
  // code can carry: nobody shipped while the question was open.
  ["license-table-check"] {
    check = "mise run license-table-check"
  }
  // The checked-in memories are a graph navigated by mem: references, and the
  // reference tooling's own check is advisory (always exits 0) — so a memory
  // renamed without reference propagation, however it was renamed, dangles
  // silently. This gates the edges: every mem:NAME in tracked markdown must
  // resolve, every memory must be addressable by its own filename, and the
  // graph root must exist (CLOUD-183).
  ["memories-check"] {
    glob = List("**/*.md")
    check = "mise run memories-check"
  }
  // `.claude/rules/rust.md` carries no module tree — it defers to mem:core as
  // the authority kept current instead. Nothing checked that authority, so a
  // module could land with no row and leave the rule pointing at an incomplete
  // map; `severity.rs` (CLOUD-168) did exactly that, past a green gate.
  // memories-check does not cover this: it gates the graph's *edges*, which
  // stay coherent while the map is missing rows (CLOUD-194).
  ["module-map-check"] {
    glob = List("crates/*/src/*.rs", ".serena/memories/core.md")
    check = "mise run module-map-check"
  }
  // House style §11 makes completions a derivation of the command spec, "so the
  // shipped binary and the generated docs can never drift" — and DoR §4 requires
  // every derived artifact be regenerated by its generator and diffed
  // byte-for-byte. Without that diff the committed script is a copy, and a copy
  // drifts silently: it keeps advertising a flag the surface dropped, and the
  // first person to notice is a user whose tab-completion lies (CLOUD-27).
  ["completions-check"] {
    glob = List("crates/batten/src/surface.rs", "crates/batten/src/cli.rs", "completions/*")
    check = "mise run completions-check"
  }
  // The adoption claim is token economics, and a benchmark nobody else can
  // reproduce is a marketing artifact rather than a proof (CLOUD-119). This is
  // the same derived-artifact shape as the two entries either side of it — the
  // published table is regenerated from the committed fixtures and diffed
  // byte-for-byte — plus the honesty predicate read back off those bytes: a
  // figure with no workload, baseline, run count and method is refused, and so
  // is a capability reporting "not measured" with no reason. Globbed on the
  // declarations and fixtures, and on the modules whose output shape IS the
  // measurement, since a change to any of them moves the numbers.
  //
  // `token-bench`, not `bench`: CLOUD-207's `mise run bench` measures batten's
  // INVOCATION COST and landed under that name first. Two benchmarks with two
  // subjects need two names, and the more specific one moves.
  ["token-bench-check"] {
    glob =
      List(
        "bench/tokens/*",
        "bench/tokens/fixtures/**",
        "mise-tasks/token-bench",
        "mise-tasks/token-bench-check",
        "crates/batten/src/output.rs",
        "crates/batten/src/findings.rs",
        "crates/batten/src/outputs.rs",
        "crates/batten/src/exec.rs",
      )
    check = "mise run token-bench-check"
  }
  // The JSON Schema is derived from the config types (DoR §1), and it is
  // *published* — a released asset and the `.taplo.toml` binding an editor
  // resolves. So a stale one does not merely go unused: it tells a consumer
  // their valid config is invalid, or waves through one `batten check` refuses.
  // Nothing in the Rust build reads the committed file, so only this diff can
  // notice (CLOUD-33).
  // Consumer #1: the lint Batten ships, run against the config Batten is gated
  // by. A policy engine whose own policy gates nothing is the failure this
  // project exists to make impossible — and it is exactly the kind that hides,
  // because the config parses, the schema validates and `batten check` exits 0
  // over a rule set that has been switched off (CLOUD-87).
  ["config-lint"] {
    glob = List("batten.toml", "crates/batten/src/lint.rs", "crates/batten/src/trust.rs")
    check = "mise run config-lint"
  }
  ["schema-check"] {
    glob =
      List(
        "crates/batten/src/config.rs",
        "crates/batten/src/rules.rs",
        "crates/batten/src/severity.rs",
        "schema/*",
      )
    check = "mise run schema-check"
  }
  // The SBOM is published too, and its failure mode is worse than the schema's: a
  // wrong inventory is a false claim about what shipped, read by whoever is doing
  // vendor review rather than by anyone here who could notice. Globbed on the two
  // inputs that can move it — the lockfile it must agree with, and the workflows
  // whose pinned actions the scan catalogs (CLOUD-262).
  ["sbom-check"] {
    glob = List("Cargo.lock", ".github/workflows/*")
    check = "mise run sbom-check"
  }
  // An MCP allow rule that matches no tool name grants nothing and says nothing
  // about it — the only symptom is an approval prompt on every call, which
  // reads as harness behaviour rather than as a settings bug. This repo shipped
  // exactly that: `mcp__Linear` allowed, Linear arriving as a claude.ai
  // connector under `mcp__claude_ai_Linear__*`, no rule matching either way.
  ["mcp-allow-check"] {
    glob = List(".claude/settings.json")
    check = "mise run mcp-allow-check"
  }
  // .mcp.json launches Serena through a SCOPED `mise exec` — naming the tool, so
  // one unrelated tool failing to install cannot take the server down with it
  // (CLOUD-316: a bare exec provisions the whole toolchain first, and a
  // transient release-plz network error cost a whole session's Serena). Scoping
  // writes the pin down a second time, and a drift there is silent in the worst
  // way: `mise exec` installs whatever version it is handed, so the server keeps
  // running the old one while mise.lock and the SBOM describe the new. This
  // gates both halves — the versions agree, and the launch stays scoped.
  ["mise-pin-agreement"] {
    glob = List(".mcp.json", "mise.toml")
    check = "mise run mise-pin-agreement"
  }
  // A pattern reaching awk through `-v` goes through assignment escape
  // processing first, and what that does to a backslash is undefined across
  // implementations — gawk strips it, mawk keeps it. ready-lint matched its §8
  // label that way: green on mawk locally, matching NOTHING on the gawk runner,
  // so the clause went back to passing silently and took three older tests with
  // it. A gate that cannot match its own label does not fail, it passes.
  ["awk-regex-check"] {
    glob = List("mise-tasks/*", "*.sh")
    check = "mise run awk-regex-check"
  }
  // `producer | grep -q P` under pipefail can report FAILURE on a match: grep
  // exits at the first hit, a still-writing producer dies of SIGPIPE, and
  // pipefail promotes 141. It is a race (2 in 300 runs on a two-commit range),
  // so it passes review and passes tests. landed-check reported a clean board
  // over three landed issues that way; issue-guard denied `gh pr ready` on a
  // branch whose every commit carried Refs: CLOUD-186 — it blocked its own PR.
  ["pipefail-grep-check"] {
    glob = List("mise-tasks/*", "*.sh")
    check = "mise run pipefail-grep-check"
  }
  // Completeness of mise.lock, asked of the committed bytes. The old lock-check
  // asked it by running `mise lock` and diffing, which answers "did upstream
  // change" instead — and never removes or repairs an existing entry, so a
  // stably-wrong lockfile passed forever. One did: a cargo-zigbuild platform key
  // with a checksum and no url, which lock-check called "complete and current"
  // on every run. Currency now runs on a schedule, off the landing path.
  ["lock-complete"] {
    glob = List("mise.lock", "mise.toml")
    check = "mise run lock-complete"
  }
  // CI minutes are metered and this sandbox is not, so the workflow contract's
  // promise — CI confirms what a local run already proved — has to be a gate
  // and not prose. Three properties over the committed text: no job runs on a
  // draft, every PR workflow supersedes its own runs, and every task CI runs is
  // one `verify` runs. zizmor.yml violated the first two for its whole life,
  // which also meant re-drafting a red PR did not stop the spend (CLOUD-240).
  ["ci-local-parity"] {
    glob = List(".github/workflows/*.yml", "mise.toml")
    check = "mise run ci-local-parity"
  }
  // Every job already declared a timeout, so the absence of a limit was never
  // the problem — the numbers were boilerplate, at 3.4x to 75x of measured p95.
  // A cap at 75x cannot fail a job that is merely broken-slow, and it is inert
  // as feedback: `ci` could double and every gate would stay green. So this
  // gates the JUSTIFICATION, not the limit: a budget comment beside each value,
  // either `grandfathered` (dated debt, visibly not a justification) or a
  // measured `p95=<n>s x<mult>` whose arithmetic must agree with the declared
  // minutes. Whether a budget still matches reality is a property of the world
  // and runs on a clock instead (timeout-drift), the lock-complete split.
  ["timeout-check"] {
    glob = List(".github/workflows/*.yml")
    check = "mise run timeout-check"
  }
  // Every agent pays AGENTS.md on every turn, so its size is a per-turn tax
  // rather than a style question. Counted with any memory declared always-load,
  // since moving a section into one of those moves the cost without cutting it.
  //
  // This was `mise run context-budget`, a ~50-line shell task, until CLOUD-50
  // moved the predicate into the engine. `batten.toml` now carries the counted
  // set and both thresholds, so `batten.toml` joins the glob: changing the
  // budget must re-run the gate that enforces it.
  ["policy-budget"] {
    glob = List("AGENTS.md", ".serena/memories/always/*.md", "batten.toml")
    check = "mise run policy-budget"
  }
  // The other half of `batten-check`'s glob (CLOUD-224). That list is derived
  // from batten.toml — every `[[rule]]` glob, every declared budget file — so
  // writing it here makes hk.pkl a second authority over a set the config
  // already defines, and a second authority narrows SILENTLY: add a rule whose
  // glob names a path outside the list and the step stops running for commits
  // that touch only that path, with nothing going red. A glob without this is
  // half a change (non-negotiable 2).
  ["batten-glob-check"] {
    glob = List("batten.toml", "hk.pkl")
    check = "mise run batten-glob-check"
  }
  // The macOS release artifacts are linked on Linux by zig with no Apple SDK.
  // A dependency that links a system framework breaks that, and `cross-check`
  // cannot see it because `cargo check` never links — so without this gate the
  // first symptom is the release workflow failing after the tag is cut.
  //
  // Globbed on the manifests alone (CLOUD-224): the predicate is `cargo metadata
  // --filter-platform` over the resolved graph, so the inputs are exactly the
  // files that can move that graph. Nothing else can add a dependency.
  ["macos-link-check"] {
    glob = List("Cargo.toml", "Cargo.lock", "crates/**/Cargo.toml")
    check = "mise run macos-link-check"
  }

  // --- shell: the mise-tasks/ programs and the bats suite -------------------

  // The builtins match on shebang as well as extension, which is what the
  // extensionless `mise-tasks/*` programs need — a hand-written glob would
  // have to enumerate them.
  // `completions/` is generated, not authored: the bytes belong to
  // `batten generate completions`, and `completions-check` asserts they are
  // exactly what the binary emits. Formatting or linting them makes those two
  // gates contradict each other — shfmt reformats the committed script, the
  // drift gate then reports it as drift, and `mise run fmt` cannot reach green.
  // Excluded from the authored-shell steps for that reason, never because the
  // findings would be inconvenient (CLOUD-27).
  local generated = List("completions/*")
  ["shfmt"] = (Builtins.shfmt) {
    check_first = true
    exclude = generated
  }
  ["shellcheck"] = (Builtins.shellcheck) {
    depends = List("shfmt")
    // Upstream runs shellcheck at its default severity; this repo treats
    // style-level findings as failures, the same posture as clippy's
    // -D warnings.
    check = "shellcheck --severity=style --external-sources {{files}}"
    exclude = generated
  }
  // The shell programs' test suite (bats), the counterpart to `test` for Rust.
  // The gh guard ships with its gate this way: the policy table must block
  // exactly the hand-rolled shapes and nothing else (non-negotiable 2).
  ["test:bats"] {
    depends = List("shellcheck")
    glob = List("mise-tasks/*", "tests/*.bats")
    check = "mise run test:bats"
  }

  // --- config formats ----------------------------------------------------

  // mise.toml is the most-edited file in the repo and had no formatter, so
  // hand edits drifted in spacing and key order. taplo lints it (duplicate
  // keys, bad syntax) and formats it.
  ["taplo"] = Builtins.taplo
  ["taplo-format"] = (Builtins.taplo_format) {
    depends = List("taplo")
    check_first = true
  }
  // `pkl eval` is the only thing that proves this file is valid. Without it a
  // malformed hk.pkl surfaces when a hook tries to run — the worst possible
  // moment — rather than at check time.
  ["pkl"] = (Builtins.pkl) {
    // Command overridden to route through pkl-check, which supplies the
    // proxy CA the JVM needs in the web sandbox; upstream's file selector is
    // unchanged.
    check = "mise run pkl-check {{files}}"
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    depends = List("pkl")
    check_first = true
  }
  // Markdown only. prettier also handles JS/CSS/YAML/JSON, none of which this
  // repo has by hand — pointing it at the workflows would churn files that
  // actionlint and zizmor already own.
  ["prettier"] = (Builtins.prettier) {
    glob = List("**/*.md")
    check_first = true
  }

  // --- workflows ------------------------------------------------------------

  // actionlint catches workflow *mistakes* (bad `on:` keys, undefined matrix
  // refs, shellcheck over `run:` blocks); zizmor, run separately in `verify`
  // and CI, catches workflow *security* problems. They do not overlap.
  ["actionlint"] = Builtins.actionlint

  // --- rust ------------------------------------------------------------------

  ["cargo-fmt"] = (Builtins.cargo_fmt) {
    // check_first: skip the fixer (a write pass) on the common case where the
    // tree is already formatted; only rewrite when it isn't. (fix mode only.)
    check_first = true
    // Routed through the task so `mise run lint:fmt` and this step cannot
    // disagree about what "formatted" means. Costs no file-scoping: upstream's
    // check is already whole-workspace (`--manifest-path
    // {{workspace_indicator}}`), never file by file. The FIXER stays upstream's,
    // so the fix/check split still comes from the builtin.
    check = "mise run lint:fmt"
  }
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    depends = List("cargo-fmt")
    // Upstream lints the default target set at default severity. The
    // workspace lints are only meaningful if every target is checked and a
    // warning fails, so the command — and only the command — is ours.
    check = "mise run lint:clippy"
  }
  // Tests the whole workspace because a change in one crate can break another.
  ["test"] {
    depends = List("cargo-clippy")
    // The fixture corpus is committed data the suite reads, so a fixture-only
    // commit must run the tests too (CLOUD-63). Without this entry the corpus
    // is exercised in CI (`hk check --all` ignores globs) but skipped at
    // pre-commit, which is the half that gives feedback while it is cheap.
    glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock", "crates/batten/tests/fixtures/**")
    check = "mise run test:cargo"
  }
  // Consumer #1 in practice: the committed batten.toml, evaluated by the engine
  // it configures, over this repository. Chained after `test` for the same
  // reason the cargo steps chain: exactly one cargo build holds the target-dir
  // lock at a time.
  //
  // This carried NO glob for its whole life, on the reasoning that any file can
  // carry a violation — so `cargo run` rebuilt the engine on every commit
  // whatever it touched: 9.47s cold from a fresh clone (CLOUD-212 run 1, D8)
  // against 0.16s for the cheapest gate in the same run, and 133-141ms warm,
  // forever (CLOUD-224).
  //
  // The glob is the union of what `batten check` ACTUALLY reads, which is three
  // things and not the two the obvious reading gives (crates/batten/src/lib.rs,
  // `run_check_with`):
  //
  //   1. every [[rule]], over that rule's own `glob` — and those reach well
  //      outside crates/: mise.toml, .github/workflows/*.yml, tests/*.bats
  //   2. `budget::measure_all`, because a declared budget is a gate under
  //      `check` and not only under `policy budget` (CLOUD-50) — so AGENTS.md
  //      and .serena/project.yml are genuine inputs, and "a Markdown-only change
  //      cannot change this verdict" is FALSE for the most-edited Markdown file
  //      in the repo
  //   3. `defects::gate`, inert while batten.toml declares no [defects]
  //
  // plus the engine and its dependencies, because the task deliberately uses
  // `cargo run` so the gate judges the working tree's engine and config as the
  // PAIR that ships (mise.toml, task comment). A glob tight enough to skip when
  // a dependency moves would be the false green this whole gate model exists to
  // prevent.
  //
  // Deriving that union from batten.toml by hand makes hk.pkl a second authority
  // over it, which narrows silently the next time a rule adds a glob — half a
  // change by non-negotiable 2. `batten-glob-check` below is the other half.
  ["batten-check"] {
    depends = List("test")
    glob =
      List(
        "batten.toml",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        "mise.toml",
        ".github/workflows/*.yml",
        "tests/*.bats",
        "AGENTS.md",
        ".serena/project.yml",
      )
    check = "mise run batten-check"
  }
}

// Report every failing step in one pass rather than stopping at the first —
// one `mise run ci` should surface the whole list, not one failure at a time.
fail_fast = false

hooks {
  // Conventional Commits (https://www.conventionalcommits.org/en/v1.0.0/).
  // PRs land by fast-forward, so every commit reaches main with its original
  // SHA and must be conventional for release-plz to compute semver correctly.
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = "mise run commit-msg {{commit_msg_file}}"
      }
    }
  }
  ["pre-commit"] {
    // Check only what is staged, and never let a fixer clobber unstaged work:
    // hk stashes the working tree, runs the steps, then restores it via
    // three-way merge. patch-file is faster than `git stash` and sidesteps
    // index-lock races. See https://hk.jdx.dev/environment_variables.
    stash = "patch-file"
    steps = gate
  }
  // Read-only variant driven by `hk check --all` (via `mise run hooks`) in CI.
  ["check"] {
    steps = gate
  }
  // `hk fix --all`, what `mise run fmt` calls: run every fixer over the tree.
  ["fix"] {
    fix = true
    steps = gate
  }
}
