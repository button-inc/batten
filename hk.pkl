// Git hooks for this repository, run by hk (https://hk.jdx.dev) — a single Rust
// binary provisioned through mise (see mise.toml), no Node.js involved.
//
// Every step delegates to a mise task, so the hook, CI, and a local `mise run`
// all execute byte-identical commands — mise.toml is the single source of truth.
//
// Activation is per-clone and manual — creating this file does nothing until:
//   hk install
// is run once (see CONTRIBUTING.md). hk stores the hooks in .git/hooks.
amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

hooks {
    // Conventional Commits (https://www.conventionalcommits.org/en/v1.0.0/).
    // PRs land by fast-forward, so every commit reaches main with its original
    // SHA and must be conventional for release-plz to compute semver correctly.
    ["commit-msg"] {
        steps {
            ["conventional-commit"] {
                check = "mise run commit-msg {{commit_msg_file}}"
            }
        }
    }
    ["pre-commit"] {
        steps {
            ["fmt"] {
                glob = List("**/*.rs")
                check = "mise run fmt-check"
                fix = "mise run fmt"
            }
            ["lint"] {
                glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")
                check = "mise run lint"
            }
            // Tests the whole workspace because a change in one crate can break
            // another.
            ["test"] {
                glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")
                check = "mise run test"
            }
        }
    }
}
