// Git hooks for this repository, run by hk (https://hk.jdx.dev) — a single Rust
// binary provisioned through mise (see mise.toml), no Node.js involved.
//
// Steps come from hk's own `Builtins` wherever one exists: upstream already
// encodes the file selectors, batching, shebang detection and fix/check split
// for these tools, and each builtin ships with its own tests. Repo-specific
// steps — the gates that exist only here — are written out below. Where a
// builtin's command needs our stricter flags, the command is overridden and
// nothing else, so the selector logic still comes from upstream.
//
// Activation is per-clone and manual — creating this file does nothing until:
//   hk install
// is run once (see CONTRIBUTING.md). hk stores the hooks in .git/hooks.
amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

// The gate, defined once and shared by two hooks:
//   - `pre-commit` runs it in fix mode on the way into a commit (stashes, applies
//     the fixers).
//   - `check` runs it in check-only mode; CI drives it via `mise run hooks`
//     (`hk check --all`) so the exact hook config is exercised on CI too, not
//     just locally. If a step is misconfigured here, CI catches it.
// clippy and the test build are both whole-workspace cargo compiles. Chaining
// cargo-fmt -> cargo-clippy -> test keeps exactly one cargo build holding the
// target-dir lock at a time: parallel steps would only serialize on that lock
// while oversubscribing the CPU. Each step also reads the formatted, then
// linted, tree.
local gate = new Mapping<String, Step> {
  // --- repo-specific gates (no upstream builtin exists) ---------------------

  // Enforces the "revisit hk config" reminder as a runnable gate, not prose:
  // fails if hk's pinned version drifts between mise.toml and this file's
  // `amends` URL. Fires on any change to either file — which includes every
  // hk version bump, the moment to re-check this config (see AGENTS.md).
  ["hk-version"] {
    glob = List("hk.pkl", "mise.toml")
    check = "mise run hk-version"
  }
  // CI installs a narrow, per-job tool set instead of the whole toolchain
  // (ci.yml, install_args). That is worth ~10s per job, and its cost is a
  // second place tool names are written down. `mise install` does not fail on
  // an unknown name, so drift between the two files surfaces late as "command
  // not found". This is that rule's mechanism: the names must resolve.
  // The glob is every workflow, not `ci.yml` alone: since CLOUD-812 this gate
  // also asks whether a `pull_request` workflow runs the mise action with no
  // `install_args` at all, and that question is about files `ci.yml` does not
  // name. A glob narrower than the subject means the pre-commit tier never
  // selects the step that would have caught the very file being added.
  ["ci-tools-check"] {
    glob = List(".github/workflows/*.yml", "mise.toml")
    check = "mise run ci-tools-check"
  }
  // The honesty gate for `rust.yml`'s `paths:` filter (CLOUD-398). It ships with
  // the filter because a filter that is too NARROW fails silently: the four jobs
  // are absent, `checks-green` accepts absent by design, and the run is green
  // without their verdict. `mise.toml` is in the glob because the filter has to
  // select it — the jobs invoke `mise run` tasks — so a change here is a change
  // to what the filter must cover.
  ["rust-paths-check"] {
    glob = List(".github/workflows/rust.yml", "mise.toml")
    check = "mise run rust-paths-check"
  }
  // The per-suite cost corpus, held to the tree it describes (CLOUD-352). Not
  // `slow`: the predicate is set membership over committed text and answers in
  // milliseconds — it re-runs NOTHING. The durations themselves are a clock and
  // are deliberately not gated, since wall clock is not reproducible and a gate
  // demanding byte equality on one would be red on every second run.
  //
  // Globbed on the corpus and on the suites, because both directions rot: a
  // suite added without regenerating is a file nothing records, and a suite
  // deleted leaves a cost attached to nothing.
  ["suite-bench-check"] {
    glob = List("bench/suites/RESULTS.md", "tests/*.bats")
    check = "mise run suite-bench-check"
  }
  // CLOUD-266's rule reaches the one budget nobody had looked at (CLOUD-668).
  // The MCP startup budget was the host's 30000ms default, never measured, and
  // Serena's worst observed SUCCESSFUL connect is 16650ms — 1.8x headroom, which
  // came up short twice in one session. Exceeding it is not a retry: Serena is
  // absent for the whole session, which takes `.serena/memories/**` with it.
  // The measurement table lives in the task's own header.
  ["mcp-timeout-budget"] {
    glob = List(".claude/settings.json", "mise-tasks/mcp-timeout-budget.sh")
    check = "mise run mcp-timeout-budget"
  }
  // The floor is a derived copy of the toolchain pin (CLOUD-593), so the two
  // must agree. This REPLACES the `msrv` job, which answered the same question
  // by compiling the workspace a second time at a second toolchain — right while
  // the numbers were independent, and pure cost once they are coupled. Note what
  // the old gate could not catch: it was green through all twelve releases the
  // pin sat stale, because the two numbers agreed. Agreeing on a stale number is
  // what it was built to confirm.
  ["msrv-pin-agreement"] {
    glob = List("Cargo.toml", "mise.toml", "renovate.json5")
    check = "mise run msrv-pin-agreement"
  }
  // An MSRV cap lives in two files — the manifest bound and the bot-side
  // `allowedVersions` rule that mirrors it, because the bot cannot read a
  // manifest cap. That mirror moved from `.github/dependabot.yml` to
  // `renovate.json5` with CLOUD-660, which retired the bot the old file
  // configured; the predicate is unchanged and both sets are still empty.
  // Lift only the manifest side and everything passes while the crate stays
  // frozen: the bot keeps withholding a version the manifest now admits, and
  // nothing is red. That half-lift is the direction with no symptom, and it is
  // why the row is set equality both ways rather than a one-sided check.
  //
  // Both sets are empty as of CLOUD-593, and the row is still load-bearing: it
  // is a ratchet on the next cap added to either file. A gate that only worked
  // while a list was non-empty would have been deleted with the list.
  ["cap-drift"] {
    glob = List("Cargo.toml", "renovate.json5")
    check = "mise run cap-drift"
  }
  // The sibling question about the same two files, asked of the RESOLUTION
  // rather than the requirement (CLOUD-767). `cap-drift` decides whether the
  // manifest and the bot config agree about what may be proposed;
  // `digest-major-agreement` decides whether what was actually resolved still
  // composes. A caret requirement is silent on the second, which is why this
  // reads `Cargo.lock` and that one does not.
  //
  // The rule it carries was a `Cargo.toml` comment asserting something untrue
  // for as long as `gix` had been a dependency. Prose is feedforward only.
  ["digest-major-agreement"] {
    glob = List("Cargo.toml", "Cargo.lock")
    check = "mise run digest-major-agreement"
  }
  // `coverage` and `scorecard` emit a number for a human and must never gate a
  // branch — a coverage threshold rewards line-touching, and scorecard scores
  // deliberate design decisions (trunk-based review, the landing lease's
  // `actions: write`) as defects. Both said so in a comment and nothing held
  // it: the only thing keeping them off the landing path was that nobody had
  // added them to it (CLOUD-582). This is the inverse of `ci-parity`'s
  // "every task CI runs, verify runs" — named reports appear in NEITHER
  // `[tasks.verify]` nor any `pull_request` workflow. Kept separate from that
  // gate because the two fail for opposite reasons and one deny cannot say both.
  ["report-only-check"] {
    glob = List(".github/workflows/*.yml", "mise.toml", "mise-tasks/report-only-check.sh")
    check = "mise run report-only-check"
  }
  // Enforces the "research goes to Linear, not a repo docs/ tree" directive as
  // a runnable gate, not prose (see AGENTS.md): fails if any docs/ path is
  // tracked. Research deliverables and evidence notes attach to the Linear
  // issue; the repo carries code and its close-in config, not research prose.
  //
  // Deliberately keeps NO glob where its two glob-less neighbours got one
  // (CLOUD-224). Its input genuinely is the whole index: it fails on any TRACKED
  // docs/ path, including one an earlier commit left behind, so a glob would let
  // a violation persist unreported for every commit that did not touch it. It
  // costs ~95ms, which is what makes that affordable.
  ["no-docs-tree"] {
    check = "mise run no-docs-tree"
  }
  // The coverage half of the nextest swap (CLOUD-813). `test:cargo` runs
  // `cargo nextest run`, which does not execute doctests; the swap was safe
  // because `cargo test --doc --workspace` reported zero on this workspace, and
  // that emptiness is a measurement rather than a property. This asserts it
  // still holds, so a doc example cannot arrive as dead code that reads like a
  // tested one.
  //
  // Globbed on the crate sources it scans, unlike its glob-less neighbour above:
  // a fence can only appear in a tracked `.rs` file, so the input really is that
  // set and a commit touching none of them cannot change the answer.
  ["no-doctests"] {
    glob = List("crates/**/*.rs")
    check = "mise run no-doctests"
  }
  // The third half of the same non-negotiable. CONTRIBUTING.md's license table
  // ends "Confirm each _to confirm_ entry before that tool is adopted in a
  // shipped release" — a release precondition stated in prose, which nothing
  // enforced while three of five rows sat unresolved (CLOUD-325). The table
  // stays the authority; this only asserts that no row is still an open
  // question. It cannot check that a recorded license is *correct* — that is a
  // human reading an upstream LICENSE — so it proves the narrower thing an exit
  // code can carry: nobody shipped while the question was open.
  ["license-table-check"] {
    check = "mise run license-table-check"
  }
  // The mechanism CLOUD-847 shipped without (CLOUD-860). That row landed
  // `.coderabbit.yaml` after measuring what each key buys — a formal
  // CHANGES_REQUESTED review so a verdict exists at all, review on drafts so it
  // exists in the phase that costs nothing, and `gitleaks` kept because
  // `mise run ci` is `if: draft == false` and a draft would otherwise have no
  // secret scanning. Nothing then held the file to those readings, and the
  // failure is silent in the worst direction: reviews simply stop, which looks
  // exactly like nobody having pushed.
  //
  // Globbed on the one file it reads, unlike its glob-less neighbours above: a
  // commit touching nothing else cannot change the answer, so the whole-index
  // scan they need would only cost time here.
  ["coderabbit-config-check"] {
    glob = List(".coderabbit.yaml")
    check = "mise run coderabbit-config-check"
  }
  // The two-tier gate ships with its mechanism (non-negotiable 2). The steps
  // below marked `profiles = List("slow")` are skipped at pre-commit and run by
  // `check`, and the dangerous direction is not the obvious one: a tier that
  // stops being SKIPPED merely makes commits slow, while a tier that stops being
  // RUN by `check` removes clippy, the test suite and `batten-check` from
  // `mise run ci`, `verify` and CI at once — green everywhere, nothing tested.
  // Deleting the config-level `profiles` line does exactly that, silently. This
  // reds it, reading the plan rather than a timing, since a timing cannot tell a
  // skipped step from a cached one (CLOUD-509).
  //
  // Globbed on both files that can move the verdict: hk.pkl declares the tier,
  // and the hook is the one place it is switched off. A glob on hk.pkl alone
  // would let the `--profile` flag be deleted from the hook with nothing red —
  // the step would not even run for that commit.
  ["hook-profile-check"] {
    glob = List("hk.pkl", ".claude/hooks/git-hook.sh")
    check = "mise run hook-profile-check"
  }
  // `.claude/rules/rust.md` carries no module tree — it defers to mem:core as
  // the authority kept current instead. Nothing checked that authority, so a
  // module could land with no row and leave the rule pointing at an incomplete
  // map; `severity.rs` (CLOUD-168) did exactly that, past a green gate.
  // memories-check does not cover this: it gates the graph's *edges*, which
  // stay coherent while the map is missing rows (CLOUD-194).
  ["module-map-check"] {
    glob = List("crates/*/src/*.rs", ".serena/memories/core.md")
    check = "mise run module-map-check"
  }
  // `.claude/rules/toolchain.md` forbids restating a value three times over and
  // then restated four, two of which had drifted — `LAND_MAX_LAPS` quoted as 8
  // where `land` defaults to 2, and `contract-drift` described as running on an
  // event nothing wires (CLOUD-506). These files are read by an agent that then
  // acts without re-deriving, so a stale parenthetical is a false premise
  // carrying the rule's authority. It fails a claim that is present and WRONG,
  // never one that is absent: the file's own rule is to defer, and a gate
  // pushing toward completeness would invert it.
  // CLOUD-479. Same glob as `rules-drift` below and for the same reason: the
  // verdict moves when a registration moves, when a task's tool use changes, or
  // when `mise.toml` pins something new. Sub-second, so it declares no profile —
  // `hook-profile-check`'s `slow-tier-empty` rule would refuse one.
  ["hook-pin-check"] {
    glob = List(".claude/settings.json", "mise-tasks/*", "mise.toml")
    check = "mise run hook-pin-check"
  }
  // CLOUD-480. The census, never `mutant` itself: this step decides whether every
  // gate in the tree is DECLARED, which is a property of the commit and costs one
  // pass over the `#MISE description` lines. `mutant` proves the declarations
  // DISCRIMINATE, which is a property of the suites and costs two filtered bats
  // runs per row, so it stays off the landing path — the same split
  // `lock-complete` and `lock-currency` were separated along.
  //
  // The glob is the three surfaces the verdict is a function of: a gate added or
  // renamed, a module added, and the set itself. Without `mise.toml` a commit that
  // only shortened the set would not fire the step that reads it.
  ["mutant-census"] {
    glob = List("mise-tasks/**", "policy/*.rego", "mise.toml")
    check = "mise run mutant-census"
  }
  // The memory glob is CLOUD-770's, and it has to be here rather than only in the
  // task: the gate now walks `.serena/memories/**`, and a step that does not list
  // it never fires on a memory-only commit — the widening would hold in `verify`
  // and `ci` while the pre-commit tier stayed blind to the surface it was added
  // for.
  ["rules-drift"] {
    glob =
      List(
        ".claude/rules/*.md",
        ".serena/memories/**/*.md",
        ".claude/settings.json",
        "mise-tasks/**",
      )
    check = "mise run rules-drift"
  }
  // The third surface derivation, and separate from the artifact comparison for
  // the reason `schema-check` is: that comparison's rows are <whole committed
  // artifact> x <generate argv>, compared byte-for-byte. The hook wiring lives as
  // SELECTED ENTRIES INSIDE a file the host shares with configuration the engine
  // does not own, so it is compared entry-wise after canonicalization — not that
  // shape (CLOUD-62). Its glob is the wiring rows, the surface row that emits
  // them, and the committed wiring itself.
  //
  // `doctor.rs` AND `batten.toml` ARE IN THE GLOB BECAUSE THE VERDICT IS
  // COMPUTED THERE. The gate stopped deriving the comparison itself when
  // CLOUD-777 moved it in-process: it now calls `batten doctor hooks -J` and
  // reads the answer, so `doctor.rs` decides every finding this step reports and
  // was not a trigger for it — a change to the deciding code did not re-run the
  // check that depends on it. `batten.toml` joins it for the same reason once
  // `[[hook.handler]]` is a wiring destination: a handler row is a registration
  // this gate is the census over.
  ["hooks-wiring-check"] {
    glob =
      List(
        "crates/batten/src/hook.rs",
        "crates/batten/src/doctor.rs",
        "crates/batten/src/surface.rs",
        ".claude/settings.json",
        "batten.toml",
        "mise-tasks/hooks-wiring-check.sh",
      )
    check = "mise run hooks-wiring-check"
  }
  // The reference is the one surface derivation with NO committed copy — it is
  // rendered at publish time, so it is current by construction and there is
  // nothing to diff it against (CLOUD-171). That removes the
  // drift question and leaves a different one: coverage. `render::markdown`
  // walks the spec, so a node the walk skips, or a future renderer that
  // summarises rather than enumerates, yields a reference that is well-formed,
  // non-empty, byte-stable and quietly missing a flag — green on every other
  // check this repository has over that file.
  //
  // Both directions, because they catch opposite failures: a flag the surface
  // declares and the reference omits tells a reader it does not exist, and a
  // flag the reference names and the surface lacks tells them to type something
  // that will not parse.
  ["reference-check"] {
    glob =
      List(
        "crates/batten/src/surface.rs",
        "crates/batten/src/cli.rs",
        "crates/batten/src/render.rs",
        "crates/batten/src/spec.rs",
        "mise-tasks/render/cli.sh",
      )
    check = "mise run reference-check"
  }
  // The adoption claim is token economics, and a benchmark nobody else can
  // reproduce is a marketing artifact rather than a proof (CLOUD-119). This is
  // the same derived-artifact shape as the two entries either side of it — the
  // published table is regenerated from the committed fixtures and diffed
  // byte-for-byte — plus the honesty predicate read back off those bytes: a
  // figure with no workload, baseline, run count and method is refused, and so
  // is a capability reporting "not measured" with no reason. Globbed on the
  // declarations and fixtures, and on the modules whose output shape IS the
  // measurement, since a change to any of them moves the numbers.
  //
  // `token-bench`, not `perf`: CLOUD-207's `mise run perf` measures batten's
  // INVOCATION COST, and it held the name `bench` until CLOUD-172 moved the whole
  // latency family into the `perf` namespace its own Mechanism specifies. Two
  // benchmarks with two subjects need two names, and neither may be `bench`.
  ["token-bench-check"] {
    // `slow` tier: re-executes `token-bench`, which builds the engine and then
    // runs N workloads x N runs. See the `profiles` note at the foot of this file.
    profiles = List("slow")
    glob =
      List(
        "bench/tokens/*",
        "bench/tokens/fixtures/**",
        "mise-tasks/token-bench.sh",
        "mise-tasks/token-bench-check.sh",
        "crates/batten/src/output.rs",
        "crates/batten/src/findings.rs",
        "crates/batten/src/outputs.rs",
        "crates/batten/src/exec.rs",
      )
    check = "mise run token-bench-check"
  }
  // The JSON Schema is derived from the config types (DoR §1), and it is
  // *published* — a released asset and the `.taplo.toml` binding an editor
  // resolves. So a stale one does not merely go unused: it tells a consumer
  // their valid config is invalid, or waves through one `batten check` refuses.
  // Nothing in the Rust build reads the committed file, so only this diff can
  // notice (CLOUD-33).
  // Consumer #1: the lint Batten ships, run against the config Batten is gated
  // by. A policy engine whose own policy gates nothing is the failure this
  // project exists to make impossible — and it is exactly the kind that hides,
  // because the config parses, the schema validates and `batten check` exits 0
  // over a rule set that has been switched off (CLOUD-87).
  ["config-lint"] {
    glob = List("batten.toml", "crates/batten/src/lint.rs", "crates/batten/src/trust.rs")
    check = "mise run config-lint"
  }
  // The same question asked of the other committed policy config (CLOUD-655).
  // `ci-parity` decides that Renovate's five cost-and-coverage keys are
  // present with the values that make them work; only upstream's own validator decides that
  // the file around them is one Renovate will accept. A config it rejects is a
  // lane proposing nothing, silently — which is the shape that let `[tools] rust`
  // sit twelve releases stale under a green weekly `lock-currency`.
  ["renovate-config-validator"] {
    glob = List("renovate.json5")
    check = "mise run renovate-config-validator"
  }
  // Every module the derived schemas are reachable from, or the step does not
  // fire on the commit that moved them. `provision.rs` and `waiver.rs` were
  // absent while both were already reachable from `Config` (CLOUD-59): a commit
  // touching only one of them changed `schema/batten.schema.json` and skipped
  // the gate that exists to notice, so the drift arrived on `main` and waited
  // for whichever later commit happened to touch `config.rs`.
  //
  // That patch fixed the INSTANCE and not the CLASS, which is why this is now
  // gated rather than merely longer. It added exactly the two modules its own
  // change touched, and left fourteen others that were already reachable from
  // `Config` — so the list was incomplete at the moment it was repaired, not
  // merely decayed since. A hand-kept list gets extended to whatever its author
  // is holding. So the list is no longer the authority — `config_schema.rs`'s
  // `the_schema_check_glob_names_every_module_the_schemas_derive_from` holds it
  // equal to the set of modules deriving `JsonSchema`, in BOTH directions, and
  // fails naming whichever side moved. A literal list is what hk needs; a test
  // is what keeps it true.
  //
  // Scope this honestly: `mise run hooks` is `hk check --all`, so `verify` and
  // CI ran the step regardless of this glob and the landing path was never
  // open. What a missing entry costs is the PRE-COMMIT firing — seconds of
  // feedback traded for a ~3-minute `verify`.
  ["schema-check"] {
    glob =
      List(
        "crates/batten/src/action.rs",
        "crates/batten/src/attribution.rs",
        "crates/batten/src/budget.rs",
        "crates/batten/src/capture.rs",
        "crates/batten/src/ci.rs",
        "crates/batten/src/commit.rs",
        "crates/batten/src/config.rs",
        "crates/batten/src/defects.rs",
        "crates/batten/src/design.rs",
        "crates/batten/src/drain.rs",
        "crates/batten/src/effect.rs",
        "crates/batten/src/exec.rs",
        "crates/batten/src/facts.rs",
        "crates/batten/src/handler.rs",
        "crates/batten/src/hook.rs",
        "crates/batten/src/judge.rs",
        "crates/batten/src/markers.rs",
        "crates/batten/src/mint.rs",
        "crates/batten/src/outputs.rs",
        "crates/batten/src/pattern.rs",
        "crates/batten/src/provision.rs",
        "crates/batten/src/prune.rs",
        "crates/batten/src/recorder.rs",
        "crates/batten/src/redirect.rs",
        "crates/batten/src/rules.rs",
        "crates/batten/src/severity.rs",
        "crates/batten/src/transcript.rs",
        "crates/batten/src/verbs.rs",
        "crates/batten/src/verdict.rs",
        "crates/batten/src/waiver.rs",
        "schema/*",
      )
    check = "mise run schema-check"
  }
  // The SBOM is published too, and its failure mode is worse than the schema's: a
  // wrong inventory is a false claim about what shipped, read by whoever is doing
  // vendor review rather than by anyone here who could notice. Globbed on the two
  // inputs that can move it — the lockfile it must agree with, and the workflows
  // whose pinned actions the scan catalogs (CLOUD-262).
  ["sbom-check"] {
    // `slow` tier: two whole-tree `syft scan dir:.` passes.
    profiles = List("slow")
    glob = List("Cargo.lock", ".github/workflows/*")
    check = "mise run sbom-check"
  }
  // The install path resolves a release asset BY NAME from a machine that has
  // never seen this repository, so a rename in `dist` that forgets one of its
  // two readers — `install.sh` and `[package.metadata.binstall]` — is green
  // everywhere here and a 404 on a user's machine (CLOUD-65). Globbed on all
  // four files that can move the contract, plus the workflow whose matrix
  // decides which targets a release carries at all.
  ["install-check"] {
    glob =
      List(
        "install.sh",
        "mise-tasks/dist.sh",
        "crates/batten/Cargo.toml",
        "Cargo.toml",
        ".github/workflows/release-artifacts.yml",
      )
    check = "mise run install-check"
  }
  // Publishing to a registry with a long-lived token is the thing OIDC exists to
  // retire, and today this repository does neither — `publish = false`, and no
  // registry secret exists (CLOUD-109). That makes the rule an implication
  // rather than an edit: while publishing is off the OIDC permission is not
  // required, and the commit that turns publishing ON must carry
  // `id-token: write` or fail here. Globbed on the config that decides it and on
  // every workflow, since a registry credential is refused wherever it appears.
  ["publish-credential-check"] {
    glob = List("release-plz.toml", ".github/workflows/*")
    check = "mise run publish-credential-check"
  }
  // The release job publishes a tag; this is what keeps it telling Linear so
  // (CLOUD-618). Both invocations must be present, SHA-pinned, and bound to the
  // tag, over a checkout deep enough to carry the commit range the action reads —
  // each of those failing produces a GREEN job and either no release record or
  // one with no issues attached, which is why prose could not hold it. The
  // release path must also REFRESH tags before resolving one, and that assertion
  // is an ordering rather than a presence: the tag is pushed from a clone the
  // runner cannot see, so a refresh placed after the resolver is the workflow
  // that ran 32 times and recorded nothing. Wiring it here rather than as a
  // CI-only step is what puts it in `mise run ci` -> `verify` -> CI, so
  // `ci-parity`'s "every task CI runs is one `verify` runs" keeps holding.
  //
  // Globbed on BOTH workflows it judges as well as the script that decides, for
  // the reason the timeout budget below states: a gate that does not re-run when
  // its subject is edited stops running for exactly the commits it exists to
  // judge. `linear-release-backfill.yml` is the second subject — the operator
  // path that records a tag which shipped before the recording worked — and it
  // needs its own trigger here or it would be judged only when the release path
  // happened to change. The batten.toml row's glob names only the script — that
  // one is the rule's subject, and `batten-glob-check` must be able to prove it
  // covered.
  ["release-tracking-check"] {
    glob =
      List(
        ".github/workflows/release-plz.yml",
        ".github/workflows/linear-release-backfill.yml",
        "mise-tasks/release-tracking-check.sh",
      )
    check = "mise run release-tracking-check"
  }
  // An MCP allow rule that matches no tool name grants nothing and says nothing
  // about it — the only symptom is an approval prompt on every call, which
  // reads as harness behaviour rather than as a settings bug. This repo shipped
  // exactly that: `mcp__Linear` allowed, Linear arriving as a claude.ai
  // connector under `mcp__claude_ai_Linear__*`, no rule matching either way.
  ["mcp-allow-check"] {
    glob = List(".claude/settings.json")
    check = "mise run mcp-allow-check"
  }
  // The same silence, one table over in the same file (CLOUD-471). The
  // `PreToolUse` matcher decides which tool calls the host spawns the hook for
  // AT ALL, so a `[[verb]]` naming a tool the matcher omits loads, validates and
  // gates nothing — the process is never spawned, no envelope is decoded, and
  // the symptom is an allow indistinguishable from a pass. `hooks-wiring-check`
  // above deliberately compares only the EVENT and the COMMAND ("THE MATCHER IS
  // NOT COMPARED"), because a matcher derived from the `Harness` enum would be
  // the repo-agnostic core asserting a consumer's tool vocabulary; the coverage
  // question therefore lands in a consumer gate, which is this one.
  //
  // Globbed on all three files that can move the verdict plus the script that
  // decides. `crates/batten/src/hook.rs` is a genuine input, not a courtesy: the
  // gate reads `Harness::ClaudeCode::write_tools()` there rather than restating
  // the set, so a tool added to that arm changes which verbs need their own name
  // in the matcher — and a gate that does not re-run when its subject moves stops
  // running for exactly the commits it exists to judge.
  ["hook-matcher-check"] {
    glob =
      List(
        ".claude/settings.json",
        "batten.toml",
        "crates/batten/src/hook.rs",
        "mise-tasks/hook-matcher-check.sh",
      )
    check = "mise run hook-matcher-check"
  }
  // A pattern reaching awk through `-v` goes through assignment escape
  // processing first, and what that does to a backslash is undefined across
  // implementations — gawk strips it, mawk keeps it. ready-lint matched its §8
  // label that way: green on mawk locally, matching NOTHING on the gawk runner,
  // so the clause went back to passing silently and took three older tests with
  // it. A gate that cannot match its own label does not fail, it passes.
  ["awk-regex-check"] {
    glob = List("mise-tasks/**", "*.sh")
    check = "mise run awk-regex-check"
  }
  // `producer | grep -q P` under pipefail can report FAILURE on a match: grep
  // exits at the first hit, a still-writing producer dies of SIGPIPE, and
  // pipefail promotes 141. It is a race (2 in 300 runs on a two-commit range),
  // so it passes review and passes tests. landed-check reported a clean board
  // over three landed issues that way; issue-guard denied `gh pr ready` on a
  // branch whose every commit carried Refs: CLOUD-186 — it blocked its own PR.
  ["pipefail-grep-check"] {
    glob = List("mise-tasks/**", "*.sh")
    check = "mise run pipefail-grep-check"
  }
  // Completeness of mise.lock, asked of the committed bytes. The old lock-check
  // asked it by running `mise lock` and diffing, which answers "did upstream
  // change" instead — and never removes or repairs an existing entry, so a
  // stably-wrong lockfile passed forever. One did: a cargo-zigbuild platform key
  // with a checksum and no url, which lock-check called "complete and current"
  // on every run. Currency now runs on a schedule, off the landing path.
  ["lock-complete"] {
    glob = List("mise.lock", "mise.toml")
    check = "mise run lock-complete"
  }
  // The one predicate `ci-local-parity` held that could not become a policy
  // module (CLOUD-1161). A foreign runner is exempt from the task-parity
  // property — there is no local Windows, so "a free local run would have caught
  // it" is false there — which leaves its cargo invocation a SECOND SPELLING of
  // `test:cargo`'s body, accurate today and only today.
  //
  // It stays a mise task because it reads the task through `mise tasks info`,
  // which is mise answering about its own graph. A policy module cannot spawn,
  // so the only expression available there is a second parser over a body mise
  // already owns — the objection the retired program stated in its own words.
  //
  // Globbed on both ends: the workflows carry the spelling and `mise.toml`
  // carries the task it must equal, so a change to either re-runs it.
  ["cargo-spelling"] {
    glob = List(".github/workflows/*.yml", "mise.toml")
    check = "mise run cargo-spelling"
  }
  // Every job already declared a timeout, so the absence of a limit was never
  // the problem — the numbers were boilerplate, at 3.4x to 75x of measured p95.
  // A cap at 75x cannot fail a job that is merely broken-slow, and it is inert
  // as feedback: `ci` could double and every gate would stay green. So this
  // gates the JUSTIFICATION, not the limit: a budget comment beside each value,
  // either `grandfathered` (dated debt, visibly not a justification) or a
  // measured `p95=<n>s x<mult>` whose arithmetic must agree with the declared
  // minutes. Whether a budget still matches reality is a property of the world
  // and runs on a clock instead (timeout-drift), the lock-complete split.
  ["timeout-check"] {
    glob = List(".github/workflows/*.yml")
    check = "mise run timeout-check"
  }
  // We pin an UNRELEASED toolchain-install commit —
  // uses: jdx/mise-action@9dda3952d607125725deac9ec10a5f0e245d266b — because it is
  // the one that added the download retry, and that action ships its own built
  // dist. The pin therefore no longer matches a release tag — while renovate.json5
  // tracks the github-actions ecosystem and auto-bot-land.yml lands bot bumps
  // with no human in the loop. A bump resolving back to the pre-retry commit
  // would be a silent downgrade, auto-landed, and the next transient would read
  // as fresh. So the rule ships with its mechanism: this reds such a pin at check
  // time, which is what stops that PR going green (CLOUD-404). A denylist rather
  // than a required sha, so a real forward bump needs no edit here.
  ["mise-action-floor"] {
    glob = List(".github/workflows/*.yml")
    check = "mise run mise-action-floor"
  }
  // Every agent pays AGENTS.md on every turn, so its size is a per-turn tax
  // rather than a style question. Counted with any memory declared always-load,
  // since moving a section into one of those moves the cost without cutting it.
  //
  // This was `mise run context-budget`, a ~50-line shell task, until CLOUD-50
  // moved the predicate into the engine. `batten.toml` now carries the counted
  // set and both thresholds, so `batten.toml` joins the glob: changing the
  // budget must re-run the gate that enforces it.
  //
  // `.serena/project.yml` joins it for the same reason (CLOUD-899):
  // `[[budget.instructions.embedded]]` counts its `initial_prompt`, so it is a
  // real input, and a step that does not list its own input stops running for
  // exactly the commits it is meant to judge — the shape the `check` tier's
  // memory glob already records for CLOUD-770. `batten-check` globs it too, but
  // that step is `slow`-profile and skipped at commit time, so it covered
  // `verify` and `ci` while the pre-commit tier stayed blind. That went unnoticed
  // while the value was empty; CLOUD-864 put text in it.
  //
  // What is deliberately NOT here: `.serena/memories/always/*.md`, carried over
  // from the deleted shell task. That directory has never existed — batten.toml
  // says so where it declares the counted set — and CLOUD-298 removed the
  // engine-side copy while this one survived, matching nothing and reading to the
  // next author as evidence of an `always/` convention.
  ["policy-budget"] {
    glob = List("AGENTS.md", ".serena/project.yml", "batten.toml")
    check = "mise run policy-budget"
  }
  // The other half of `batten-check`'s glob (CLOUD-224). That list is derived
  // from batten.toml — every `[[rule]]` glob, every declared budget file — so
  // writing it here makes hk.pkl a second authority over a set the config
  // already defines, and a second authority narrows SILENTLY: add a rule whose
  // glob names a path outside the list and the step stops running for commits
  // that touch only that path, with nothing going red. A glob without this is
  // half a change (non-negotiable 2).
  ["batten-glob-check"] {
    glob = List("batten.toml", "hk.pkl")
    check = "mise run batten-glob-check"
  }
  // The shipped skill is the dispositional surface of the interaction model, and
  // two of its properties are specification rather than taste: a ~300-line
  // budget somebody measured (a 341-line skill beat a 2,187-line one head to
  // head), and the requirement that it describe only verbs the binary has.
  // Markdown compiles against nothing, so without this the skill can name a verb
  // that does not exist and stay green forever — teaching an agent to build a
  // command line that cannot work (CLOUD-213).
  //
  // Globbed on `crates/batten/src/{surface,exit}.rs` as well as the skill: the
  // authorities are `batten spec` and `batten --help`, so RENAMING a verb or
  // changing an exit meaning must re-run this, not just editing the prose. That
  // is the same both-ends glob the surface-derivation gates carry.
  ["skill-check"] {
    glob =
      List(
        "skills/**",
        ".claude/skills/**",
        "mise-tasks/skill-check.sh",
        "crates/batten/src/surface.rs",
        "crates/batten/src/exit.rs",
      )
    check = "mise run skill-check"
  }
  // The macOS release artifacts are linked on Linux by zig with no Apple SDK.
  // A dependency that links a system framework breaks that, and `cross-check`
  // cannot see it because `cargo check` never links — so without this gate the
  // first symptom is the release workflow failing after the tag is cut.
  //
  // Globbed on the manifests alone (CLOUD-224): the predicate is `cargo metadata
  // --filter-platform` over the resolved graph, so the inputs are exactly the
  // files that can move that graph. Nothing else can add a dependency.
  ["macos-link-check"] {
    glob = List("Cargo.toml", "Cargo.lock", "crates/**/Cargo.toml")
    check = "mise run macos-link-check"
  }

  // --- shell: the mise-tasks/ programs and the bats suite -------------------

  // The builtins match on shebang as well as extension, which is what the
  // extensionless `mise-tasks/*` programs need — a hand-written glob would
  // have to enumerate them.
  // `completions/` is generated, not authored: the bytes belong to
  // `batten generate completions`, and
  // `crates/batten/tests/surface.rs` asserts they are exactly what the binary
  // emits. Formatting or linting them makes those two authorities contradict
  // each other — shfmt reformats the committed script, the drift assertion then
  // reports it as drift, and `mise run fmt` cannot reach green.
  // Excluded from the authored-shell steps for that reason, never because the
  // findings would be inconvenient (CLOUD-27).
  local generated = List("completions/*")
  ["shfmt"] = (Builtins.shfmt) {
    exclude = generated
  }
  ["shellcheck"] = (Builtins.shellcheck) {
    depends = List("shfmt")
    // Upstream runs shellcheck at its default severity; this repo treats
    // style-level findings as failures, the same posture as clippy's
    // -D warnings.
    check = "shellcheck --severity=style --external-sources {{files}}"
    exclude = generated
  }
  // The shell programs' test suite (bats), the counterpart to `test` for Rust.
  // The gh guard ships with its gate this way: the policy table must block
  // exactly the hand-rolled shapes and nothing else (non-negotiable 2).
  ["test:bats"] {
    // `slow` tier, and the pole of the whole gate: 100.3s of a 111.1s run at
    // nproc=4 (mise.toml). See the `profiles` note at the foot of this file.
    profiles = List("slow")
    depends = List("shellcheck")
    glob = List("mise-tasks/**", "tests/*.bats")
    check = "mise run test:bats"
  }

  // --- config formats ----------------------------------------------------

  // mise.toml is the most-edited file in the repo and had no formatter, so
  // hand edits drifted in spacing and key order. taplo lints it (duplicate
  // keys, bad syntax) and formats it.
  ["taplo"] = Builtins.taplo
  ["taplo-format"] = (Builtins.taplo_format) {
    depends = List("taplo")
  }
  // `pkl eval` is the only thing that proves this file is valid. Without it a
  // malformed hk.pkl surfaces when a hook tries to run — the worst possible
  // moment — rather than at check time.
  ["pkl"] = (Builtins.pkl) {
    // Command overridden to route through pkl-check, which supplies the
    // proxy CA the JVM needs in the web sandbox; upstream's file selector is
    // unchanged.
    check = "mise run pkl-check {{files}}"
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    depends = List("pkl")
  }
  // Markdown, plus the one hand-written YAML no other tool owns. Pointing it at
  // `.github/workflows/` would churn files that actionlint and zizmor already
  // own.
  //
  // JSON AND THE REST OF THE YAML ARE `deno-fmt`'s BELOW, not prettier's — this
  // comment used to claim the repo had no hand-written JSON/CSS/JS, and the
  // first half was false: six harness configs are hand-edited (CLOUD-104).
  // prettier keeps Markdown because `deno fmt` rewrites documentation whose
  // whitespace is load-bearing; the measurement is in `lint:deno`'s header.
  //
  // `action.yml` is the exception because NOTHING ELSE PARSES IT (CLOUD-68).
  // actionlint globs `.github/workflows` only, and zizmor — which `mise run
  // zizmor` now points at the file — answers an unparseable input with a `WARN
  // failed to parse input` and exit 0. Measured while writing it: a `contents:
  // read` inside an unquoted description made the whole file unparseable, and
  // both tools reported green over a shipped Action no runner could have loaded.
  // prettier's YAML parser is the gate that refuses it, and formatting it is the
  // by-product rather than the point.
  ["prettier"] = (Builtins.prettier) {
    glob = List("**/*.md", "action.yml")
  }
  // JSON/JSONC and the non-workflow YAML, which had NO syntax gate at all until
  // CLOUD-104: a malformed `.claude/settings.json` silently disables a hook
  // rather than failing loudly, which is the argument `pkl` above already makes
  // for this file.
  //
  // Hand-written rather than a builtin override because there is no
  // `Builtins.deno_fmt` — `hk builtins` carries `deno` and `deno_check` only.
  // So this SELECTOR IS OURS, unlike taplo's and actionlint's, and
  // `tests/hk-selection.bats` asserts its reach rather than trusting it: a
  // builtin's glob is a coverage claim, and `Builtins.shellcheck` silently read
  // zero `.bats` files for its whole life.
  //
  // The command takes no `{{files}}`: `mise run lint:deno` derives its own set
  // from `git ls-files`, so the task's pathspec stays the ONE authority on what
  // is covered and the hook cannot disagree with it. No `profiles` — this is a
  // sub-second check and belongs in the pre-commit tier.
  //
  // THE GLOB IS THE TRIGGER, THE PATHSPEC IS THE COVERAGE, and they are
  // deliberately not the same set. Measured: this glob reports `included` for
  // `.github/workflows/ci.yml` and for a fixture under
  // `crates/batten/tests/fixtures/`, both of which the task then excludes — so
  // editing one of those pays a sub-second run that correctly checks nothing of
  // theirs. Mirroring the exclusions here would buy that back at the price of a
  // second list to keep in sync, which is the drift this design is avoiding.
  // `tests/hk-selection.bats` pins the measured statuses so a change to either
  // side is visible rather than inferred.
  //
  // THE `fix` ARM ARRIVED WITH CLOUD-681 AND ITS ABSENCE WAS THE DEFECT. `fmt`'s
  // task description has always named `deno fmt` among the fixers it runs, and
  // this step carried only a `check` — so the one formatter that description
  // promised was the one `mise run fmt` could not perform. It routes through the
  // task for the same single-definition reason the check does.
  ["deno-fmt"] {
    glob = List("**/*.json", "**/*.jsonc", "**/*.yaml", "**/*.yml")
    check = "mise run lint:deno"
    fix = "mise run fmt:deno"
  }
  // CLOUD-930. `.rego` was the one config format with no formatter, and it is the
  // language CLOUD-843's campaign migrates ~80 gates onto — so the drift this
  // prevents scales with the campaign rather than with the two modules in tree
  // when it was filed. The LINT half is already gated, as three `batten.toml` rows
  // over the corpus (`policy-modules-type-check`, `policy-lint-rule-tests`, and
  // `regal lint policy/` off `.regal/config.yaml`), which is why this step is
  // formatting only.
  //
  // Both commands route through the tasks rather than spelling `opa fmt` here, for
  // the `cargo-fmt` reason: the hook and `mise run lint:rego` cannot then disagree
  // about what "formatted" means. The tasks feed `git ls-files '*.rego'` rather
  // than taking `{{files}}`, because the check must never reach a deliberately
  // malformed fixture a suite writes under `target/`.
  ["rego"] {
    glob = List("**/*.rego")
    check = "mise run lint:rego"
    fix = "mise run fmt:rego"
  }

  // --- workflows ------------------------------------------------------------

  // actionlint catches workflow *mistakes* (bad `on:` keys, undefined matrix
  // refs, shellcheck over `run:` blocks); zizmor, run separately in `verify`
  // and CI, catches workflow *security* problems. They do not overlap.
  ["actionlint"] = Builtins.actionlint

  // --- rust ------------------------------------------------------------------

  ["cargo-fmt"] = (Builtins.cargo_fmt) {
    // Routed through the task so `mise run lint:fmt` and this step cannot
    // disagree about what "formatted" means. Costs no file-scoping: upstream's
    // check is already whole-workspace (`--manifest-path
    // {{workspace_indicator}}`), never file by file. The FIXER stays upstream's,
    // so the fix/check split still comes from the builtin.
    check = "mise run lint:fmt"
  }
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    // `slow` tier: a whole-workspace compile at --all-targets --all-features.
    profiles = List("slow")
    depends = List("cargo-fmt")
    // Upstream lints the default target set at default severity. The
    // workspace lints are only meaningful if every target is checked and a
    // warning fails, so the command — and only the command — is ours.
    check = "mise run lint:clippy"
  }
  // Tests the whole workspace because a change in one crate can break another.
  ["test"] {
    // `slow` tier: a whole-workspace test build and run.
    profiles = List("slow")
    depends = List("cargo-clippy")
    // The fixture corpus is committed data the suite reads, so a fixture-only
    // commit must run the tests too (CLOUD-63). Without this entry the corpus
    // is exercised in CI (`hk check --all` ignores globs) but skipped at
    // pre-commit, which is the half that gives feedback while it is cheap.
    //
    // `batten.toml` is the same argument, one file further out, and it was
    // missing until CLOUD-59: `tests/cli.rs`'s `the_committed_*` cases read the
    // COMMITTED config at runtime and assert what it gates, so a config-only
    // commit changes what those tests measure while leaving this step's inputs
    // untouched. Measured — a `[[rule]]` added to batten.toml left the receipt
    // valid, `verify` reported `✔ test` without running it, and five of those
    // cases were red on the very next CI run.
    glob =
      List(
        "**/*.rs",
        "**/Cargo.toml",
        "Cargo.lock",
        "crates/batten/tests/fixtures/**",
        "batten.toml",
      )
    check = "mise run test:cargo"
  }
  // Consumer #1 in practice: the committed batten.toml, evaluated by the engine
  // it configures, over this repository. Chained after `test` for the same
  // reason the cargo steps chain: exactly one cargo build holds the target-dir
  // lock at a time.
  //
  // This carried NO glob for its whole life, on the reasoning that any file can
  // carry a violation — so `cargo run` rebuilt the engine on every commit
  // whatever it touched: 9.47s cold from a fresh clone (CLOUD-212 run 1, D8)
  // against 0.16s for the cheapest gate in the same run, and 133-141ms warm,
  // forever (CLOUD-224).
  //
  // The glob is the union of what `batten check` ACTUALLY reads, which is three
  // things and not the two the obvious reading gives (crates/batten/src/lib.rs,
  // `run_check_with`):
  //
  //   1. every [[rule]], over that rule's own `glob` — and those reach well
  //      outside crates/: mise.toml, .github/workflows/*.yml, tests/*.bats
  //   2. `budget::measure_all`, because a declared budget is a gate under
  //      `check` and not only under `policy budget` (CLOUD-50) — so AGENTS.md
  //      and .serena/project.yml are genuine inputs, and "a Markdown-only change
  //      cannot change this verdict" is FALSE for the most-edited Markdown file
  //      in the repo
  //   3. `defects::gate`, inert while batten.toml declares no [defects]
  //
  // plus the engine and its dependencies, because the task deliberately uses
  // `cargo run` so the gate judges the working tree's engine and config as the
  // PAIR that ships (mise.toml, task comment). A glob tight enough to skip when
  // a dependency moves would be the false green this whole gate model exists to
  // prevent.
  //
  // Deriving that union from batten.toml by hand makes hk.pkl a second authority
  // over it, which narrows silently the next time a rule adds a glob — half a
  // change by non-negotiable 2. `batten-glob-check` below is the other half.
  //
  // The task runs `batten enforce` since CLOUD-229 — the committed
  // no-conflict-markers rule delegates to `hk util check-merge-conflict`, and a
  // `command` rule spawns a process, which the read-effect `check` verb refuses.
  // `depends` STAYS, against that issue's scope note. Its premise was that
  // delegation removes the cargo build; it does not. The task still shells
  // `cargo run --quiet -p batten -- enforce`, so the step still takes the
  // target-dir lock, and dropping the chain would put it back in contention with
  // `test` — the race CLOUD-201 and CLOUD-220 were both about. What delegation
  // moved is which binary does the scanning, not whether one has to be built.
  ["batten-check"] {
    // `slow` tier: `cargo run`, so it pays a debug build — 9.47s cold, 133-141ms
    // warm (CLOUD-212 run 1, D8).
    profiles = List("slow")
    depends = List("test")
    glob =
      List(
        "batten.toml",
        "crates/**",
        "Cargo.toml",
        "Cargo.lock",
        "mise.toml",
        ".github/workflows/*.yml",
        // Recursive since CLOUD-328: the ratchet row over bats suites was
        // narrowed to one segment only to dodge a submodule the walker used to
        // count and the base rev did not. Both halves stop at a nested
        // repository now, so the row spans depth again and this must follow it.
        "tests/**/*.bats",
        // CLOUD-383's portability row scopes a `forbid` to `mise-tasks/**`, so
        // those files are an input to `batten check` now — and a step whose glob
        // does not cover its own inputs stops running for exactly the commits it
        // is meant to judge. `batten-glob-check` refused the rule until this
        // followed it, which is the coupling working rather than a chore.
        "mise-tasks/**",
        // CLOUD-876's `no-rego-metadata` row scopes a `forbid` to
        // `policy/**/*.rego`, so the modules are an input to `batten check` too
        // — the same coupling as `mise-tasks/**` above, and refused by
        // `batten-glob-check` until it followed. Without it the gate goes silent
        // for exactly the commits that add a policy module, which is when the
        // `rego.metadata.*` refusal has anything to catch.
        "policy/**/*.rego",
        // CLOUD-876's `policy-lint-rule-tests` row runs the custom Regal rule's
        // own suite, keyed on `.regal/rules/**/*.rego` — same coupling again:
        // the commit that edits the rule is exactly the commit whose suite has
        // to run, and without this entry that is the commit it does not.
        ".regal/rules/**/*.rego",
        // The two `command` rows over the Rego corpus are globbed on their own
        // configuration rather than on `policy/**`, so that they run here and in
        // no fixture (CLOUD-614) — which makes these files batten inputs in the
        // literal sense `batten-glob-check` reads, and it refused the commit
        // until they were listed.
        ".regal/config.yaml",
        "schema/policy-input.schema.json",
        "AGENTS.md",
        ".serena/project.yml",
        // CLOUD-681's `fix-selection-complete` globs this very file, so editing
        // the gate is now a reason to run the gate. `batten-glob-check` is what
        // named it — the row landed, the list did not, and that suite went red
        // on the same commit rather than the step quietly not selecting.
        "hk.pkl",
        // CLOUD-1137's `claude-shell-not-growing` ratchets shebangs under
        // `.claude/**`, so those files are a `batten check` input now — the same
        // coupling `mise-tasks/**` and `policy/**/*.rego` above carry, and
        // `batten-glob-check` refused the commit until this followed the row. It
        // is the entry that matters most for that row: a new shell program under
        // `.claude/` is exactly the commit the ratchet exists to catch, and
        // without this it is the commit the step would not run for.
        ".claude/**",
        // CLOUD-605's `no-denied-identity-prescribed` row scopes a `forbid` to
        // Markdown — where the user-level hook's remedy would get pasted — so
        // every tracked `.md` is an input now. The bare `**` below does not
        // discharge this: `batten-glob-check`'s subsumption is a `P/**` prefix
        // test and a slashless `**` matches only verbatim, so an explicit entry
        // is what the gate accepts. It is also what this list wants — each line
        // records WHICH rule made its path an input.
        "**/*.md",
        // CLOUD-59's `no-secrets` row globs `**`, because a credential can be in
        // any file and narrowing that would be choosing which files may carry
        // one. So this list is now total, and the entries above are kept rather
        // than collapsed: each records WHICH rule made its path an input, which
        // is what a reader needs the moment `**` is narrowed again.
        //
        // The cost is bounded by the tier, not by the glob: this step is
        // `slow`-profile, so it is skipped at commit time and runs under
        // `mise run ci` / `verify` / CI, where `--all` already ignores globs.
        // What a total glob actually changes is `hk check --from-ref`, which now
        // reaches this step for any commit at all.
        "**",
      )
    check = "mise run batten-check"
  }
  // CLOUD-931. `batten policy test` shipped with CLOUD-835 and was invoked by
  // nothing — no task, no step, no CI job — so the load-time tier over every
  // registered module ran only when a human typed the verb. Seven consumer
  // modules at v0.0.113, one of them a live `deny` row over this repository's own
  // privileged CI lanes.
  //
  // `slow` for `batten-check`'s reason: it is a `cargo run`, so it pays a debug
  // build. The glob is what can change the verdict — the modules, the vendored
  // presets, the config that says which are registered and enabled, and the
  // evaluator itself, since `policy::load` decides whether a module compiles at
  // all.
  ["policy-test"] {
    profiles = List("slow")
    depends = List("test")
    glob =
      List(
        "policy/**/*.rego",
        "crates/batten/src/policy/presets/**/*.rego",
        "batten.toml",
        "crates/**",
      )
    check = "mise run policy-test"
  }
}

// Report every failing step in one pass rather than stopping at the first —
// one `mise run ci` should surface the whole list, not one failure at a time.
fail_fast = false

// THE TWO TIERS, AND WHY THE POLARITY IS THIS WAY ROUND (CLOUD-509).
//
// THE FIXER SUBSET — what `mise run fmt` runs, and CLOUD-681's whole subject.
//
// hk runs a step's CHECK when that step declares no fixer, so a `fix` hook given
// the whole gate runs the whole gate. Measured before this existed, `hk fix --all
// --plan` included 58 steps of which 7 were fixers: `test:bats`, the cargo `test`
// build, `batten-check`, `policy-test`, `sbom-check` and `token-bench-check` all
// ran under `mise run fmt`, which two authorities — that task's own description
// and `.claude/rules/toolchain.md` — call the formatters-only subset. A format
// pass cost 931s, and because the installed git hook refuses to re-enter a gate
// already running, it also blocked the next commit for that whole time.
//
// THIS WAS WRITTEN AS A DERIVATION FIRST, AND THE DERIVATION IS NOT AVAILABLE.
// `for (name, step in gate) { when (step.fix != null) { ... } }` is the obvious
// spelling and it evaluates correctly under `pkl eval` — seven entries, as a
// value and rendered to JSON alike. hk's own embedded evaluator does not agree:
// the generator form made hk read `steps` as EMPTY, so `hk fix --all` reported
// "no steps to run" and silently formatted nothing, and the equivalent
// `gate.toMap().filter((k, v) -> v.fix != null)` made it abort outright with
// `Eval error: field not found: fix`. So the subset is a LIST, upstream's
// limitation rather than this file's preference — and it was caught by measuring
// the run, because an empty selection and a correct one are both green.
//
// A LIST REINTRODUCES DRIFT, WHICH IS WHY IT SHIPS WITH A GATE. Adding an eighth
// fixer to the gate and forgetting this mapping is exactly the `deno-fmt` defect
// CLOUD-681 also found — a fixer nobody routes, indistinguishable from a tree
// that needs no fixing. `fix-selection-complete` in `batten.toml` is the gate:
// it asks pkl (which CAN evaluate the predicate) for the symmetric difference
// between the gate's fixer-bearing steps and this mapping, and refuses on any.
//
// Each step is still DEFINED exactly once, in `gate`, beside the comment that
// explains it; this mapping only names which of them `fmt` reaches.
//
// `cargo-clippy` is the ONE fixer-bearing step deliberately absent, and not for
// taste. `mise.toml`'s `fix` body sequences `clippy --fix` -> the derived
// artifacts -> `hk fix --all` deliberately, because those three contend on the
// cargo target-dir lock and rewrite each other's bytes; and `fix`'s own
// description reads "everything `fmt` does, PLUS clippy's autofixes". Including
// it makes that sentence false and makes `mise run fix` run its fixer twice, the
// second time out of order. The gate carries the same exception, in one place.
local fixers = new Mapping<String, Step> {
  ["shfmt"] = gate["shfmt"]
  ["taplo-format"] = gate["taplo-format"]
  ["pkl-format"] = gate["pkl-format"]
  ["prettier"] = gate["prettier"]
  ["deno-fmt"] = gate["deno-fmt"]
  ["rego"] = gate["rego"]
  ["cargo-fmt"] = gate["cargo-fmt"]
}

// The steps above marked `profiles = List("slow")` are the six that dominate the
// gate: 111.1s total, 100.3s of it `test:bats` at nproc=4. They are not cheaper
// than they look and they are not optional — they simply do not belong on the
// path a developer pays on every `git commit`, because `hk check --all` (which
// `mise run ci`, and therefore `verify` and CI, drive over this same mapping)
// runs them regardless of glob, and `ready-guard` refuses to ready a PR with no
// `verify` receipt for that exact HEAD. The split moves WHEN the cost is paid,
// never WHETHER the check runs.
//
// Enabling `slow` HERE, at the config layer, rather than passing `--slow` at the
// call sites, is the fail-safe direction and the whole design decision. hk
// resolves profiles once at startup over `defaults < pkl < git < env < cli`, and
// the merge strategy is REPLACE, not union (`hk config explain profiles`). So:
//
//   * every hk entry point — `hk check --all`, `hk fix --all`, CI, and any bare
//     `hk` a human types — is slow-enabled by default, including one added in
//     future by someone who never reads this comment;
//   * `.claude/hooks/git-hook.sh` passes `--profile '!slow'`, whose CLI value wholly
//     supplants this list for that one process, so the six skip at pre-commit.
//
// Inverted — steps opting IN and the call sites enabling — a forgotten flag on
// any new hk call site would silently drop clippy, the test suite and
// `batten-check` with no error: a false green in the one place that must not
// have one. This way round, the same mistake only makes a commit slow.
//
// `warnings` carries "missing-profiles" so hk prints its "N steps were skipped
// due to missing profiles" summary. Without it the pre-commit skip is silent,
// and a silent skip is indistinguishable from a gate that ran and passed.
profiles = List("slow")
warnings = List("missing-profiles")

hooks {
  // Conventional Commits (https://www.conventionalcommits.org/en/v1.0.0/).
  // PRs land by fast-forward, so every commit reaches main with its original
  // SHA and must be conventional for release-plz to compute semver correctly.
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = "mise run commit-msg {{commit_msg_file}}"
      }
      // The commit-time half of the attribution gate (CLOUD-274). Range mode runs
      // from `commit-lint` and catches an offending commit after it exists; this
      // catches it BEFORE — the message is on disk and `git var` already resolves
      // the identity git is about to stamp, so refusing here means the commit is
      // never created and there is nothing to amend or rebase away.
      ["commit-attribution"] {
        check = "mise run commit-attribution-msg {{commit_msg_file}}"
      }
    }
  }
  ["pre-commit"] {
    // Check only what is staged, and never let a fixer clobber unstaged work:
    // hk stashes the working tree, runs the steps, then restores it via
    // three-way merge. patch-file is faster than `git stash` and sidesteps
    // index-lock races. See https://hk.jdx.dev/environment_variables.
    stash = "patch-file"
    steps = gate
  }
  // Read-only variant driven by `hk check --all` (via `mise run hooks`) in CI.
  //
  // memories-check lives HERE ONLY, deliberately not in `gate` (CLOUD-683).
  // It gates the memory graph's EDGES and nothing else: every mem:NAME in
  // tracked markdown must resolve, every memory must be addressable by its own
  // filename, and the graph root must exist (CLOUD-183). Membership is NOT
  // asserted — Serena hands the agent every memory name up front and documents
  // that no index or routing table is required, so an unreferenced memory is
  // discoverable and is not a defect (CLOUD-683 supersedes CLOUD-291).
  //
  // Off pre-commit because a memory written in an ephemeral container is
  // harmless and only LANDING one is destructive: blocking a local commit
  // mid-thought cost more than it caught, and a memory that cannot be committed
  // dies with the container. `verify` and `ci` both reach this hook, so nothing
  // incoherent lands — the gate moved to the point in the lifecycle it protects,
  // it did not weaken. Out of `fix` too: it carries no fixer.
  ["check"] {
    steps = (gate) {
      ["memories-check"] {
        glob = List("**/*.md")
        check = "mise run memories-check"
      }
    }
  }
  // `hk fix --all`, what `mise run fmt` calls: run every fixer over the tree —
  // and ONLY the fixers, which is `fixers`' whole subject. CLOUD-681 is what the
  // restated form cost; the reasoning lives with the derivation above, where the
  // filter that enforces it is.
  ["fix"] {
    fix = true
    steps = fixers
  }
}
