// Git hooks for this repository, run by hk (https://hk.jdx.dev) — a single Rust
// binary provisioned through mise (see mise.toml), no Node.js involved.
//
// Unlike a noisy legacy workspace, Batten is rustfmt-clean and clippy-clean from
// line one, so the pre-commit gate enforces the full trio: format, lint (warnings
// denied), and the workspace test suite. Keeping "done" honest starts with the
// tool's own commits.
//
// Activation is per-clone and manual — creating this file does nothing until:
//   hk install
// is run once (see CONTRIBUTING.md). hk stores the hooks in .git/hooks.
amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

hooks {
    // Conventional Commits (https://www.conventionalcommits.org/en/v1.0.0/): the
    // subject must start with a type, an optional scope, an optional `!`, and a
    // colon-space. This feeds changelog automation and keeps history greppable.
    ["commit-msg"] {
        steps {
            ["conventional-commit"] {
                check = """
                    head -n1 {{commit_msg_file}} | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)([(][a-z0-9._-]+[)])?!?: .+' \
                      || { echo 'commit-msg: subject must follow Conventional Commits, e.g. "feat(cli): add check subcommand"'; exit 1; }
                    """
            }
        }
    }
    ["pre-commit"] {
        steps {
            ["fmt"] {
                glob = List("**/*.rs")
                check = "mise exec -- cargo fmt --all --check"
                fix = "mise exec -- cargo fmt --all"
            }
            ["clippy"] {
                glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")
                check = "mise exec -- cargo clippy --all-targets --all-features -- -D warnings"
            }
            // Tests the whole workspace (not just staged files) because a change in
            // one crate can break another.
            ["test"] {
                glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")
                check = "mise exec -- cargo test --workspace"
            }
        }
    }
}
