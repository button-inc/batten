#!/usr/bin/env bash
#MISE description="Derive the per-suite cost corpus from the report test:bats already wrote (CLOUD-352)"
#
# WHAT THIS IS FOR. `test:bats` is 2,558 cases over 145 suites and the
# distribution is extremely uneven — measured 2026-08-21, `land-lock.bats` 175.8s
# against a median under 5s. Nothing tells an author which side of that a suite
# they are editing sits on, and the timeout budgets that would eventually notice
# fire minutes after a push, against an agent whose context is gone.
#
# IT RUNS NOTHING. The corpus is derived from `target/bats-report/report.xml`,
# which `test:bats` now leaves behind rather than deleting. Re-executing a
# 2,500-case suite to measure it would cost more than the waste it reports, and
# would be a second authority over a run that already happened.
#
# A MISSING REPORT IS COULD-NOT-LOOK, exit 2, never an empty corpus. `test:bats`
# is receipt-gated: a tree whose receipt is valid skips the run entirely, so an
# absent report is the ordinary state after a no-op lap and must not be written
# out as "every suite costs nothing". Same doctrine as `lock-complete`'s 2.
#
# Output is the corpus itself on stdout, or the path written with `--write`.
# Durations are a CLOCK, not a gate (`.claude/rules/toolchain.md`): this task
# records them, and no check here fails on a number moving.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 2

readonly REPORT="${SUITE_BENCH_REPORT:-target/bats-report/report.xml}"
readonly OUT="bench/suites/RESULTS.md"

if [ ! -f "$REPORT" ]; then
	echo "::error:: suite-bench: no report at $REPORT — \`test:bats\` has not run in this tree, or its receipt let it skip. Run \`mise run test:bats\` first; this task measures nothing itself." >&2
	exit 2
fi

# One row per `testsuite` element: name and its own `time` attribute. `awk` over
# the XML rather than a parser, for the reason `ci-tools-check` gives — the shape
# is fixed by the formatter bats ships, and a parser is a dependency this does
# not otherwise need.
rows=$(
	awk '
		match($0, /<testsuite[^>]*name="[^"]*"[^>]*time="[^"]*"/) {
			line = substr($0, RSTART, RLENGTH)
			match(line, /name="[^"]*"/); nm = substr(line, RSTART + 6, RLENGTH - 7)
			match(line, /time="[^"]*"/); tm = substr(line, RSTART + 6, RLENGTH - 7)
			if (nm != "" && tm != "") printf "%s\t%s\n", tm, nm
		}
	' "$REPORT" | sort -rn
)

if [ -z "${rows//[[:space:]]/}" ]; then
	echo "::error:: suite-bench: $REPORT carries no <testsuite> element with a name and a time, so there is nothing to derive. This is could-not-look, not an empty corpus." >&2
	exit 2
fi

# FULL PRECISION for the arithmetic, rounded only where it is printed. Rounding
# first and dividing second reported a single-suite corpus as 105% of itself.
total=$(awk -F'\t' '{s+=$1} END {printf "%.6f", s+0}' <<<"$rows")
total_shown=$(awk -v t="$total" 'BEGIN {printf "%.1f", t}')
count=$(wc -l <<<"$rows" | tr -d ' ')

emit() {
	echo "# Per-suite cost of \`test:bats\`"
	echo
	echo "Generated by \`mise run suite-bench\` from the report \`test:bats\` writes."
	echo "Do not hand-edit. Durations are wall clock for the suite alone, as the"
	echo "runner measured it; the suite runs \`--no-parallelize-within-files\`, so a"
	echo "file's number is its own serial cost and is what an author adding a case"
	echo "to it pays."
	echo
	echo "- suites: $count"
	echo "- serial total: ${total_shown}s"
	echo
	echo "| seconds | share | suite |"
	echo "| ---: | ---: | --- |"
	awk -F'\t' -v tot="$total" '{
		pct = (tot > 0) ? ($1 / tot) * 100 : 0
		printf "| %.1f | %.1f%% | `tests/%s` |\n", $1, pct, $2
	}' <<<"$rows"
}

if [ "${1:-}" = "--write" ]; then
	mkdir -p "$(dirname "$OUT")" || exit 2
	emit >"$OUT" || exit 2
	echo "suite-bench: $count suite(s), ${total_shown}s serial, written to $OUT"
else
	emit
fi
