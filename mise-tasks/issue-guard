#!/usr/bin/env bash
#MISE description="PreToolUse hook body: deny `gh pr create`/`gh pr ready` unless the work names a CLOUD-<n> issue"
#
# The diagnosis this exists to fix, stated plainly because it is about agent
# behaviour and therefore easy to mistake for a memory problem:
#
# Every discipline in this repo that agents reliably follow has a gate that
# fires on a tool call they cannot avoid. `verify` is never skipped because
# `ready-guard` denies `gh pr ready` without its receipt. Memories go through
# the Serena tools because `memory-guard` denies the direct write. Commit
# subjects conform because `commit-msg` rejects them.
#
# Every discipline agents reliably SKIP is prose in AGENTS.md with no gate on
# the path they actually take: search the board before starting, move the issue
# in lockstep, leave outstanding items on the issue rather than in a chat
# message that vanishes with the session. `graph-check` gates the board's
# internal coherence, but it is a pure function of stdin someone must choose to
# pipe — nothing makes a session consult the board at all.
#
# So the behaviour tracks the enforcement surface exactly, which is what
# AGENTS.md rule 2 already predicts: "Prose is feedforward only; a log without
# a gate is sensor only." The board section was prose. This is its mechanism.
#
# The predicate: opening or readying a PR requires naming a CLOUD-<n> issue,
# in the branch name, in any commit on the branch, or in the PR body being
# passed. You cannot name an issue you have not looked up, so the gate that
# blocks landing is also what forces the search — at the one moment in the
# lifecycle that cannot be routed around.
#
# What that identifier actually buys, which is more than traceability: the
# tracker's own GitHub integration consumes it and performs the state
# transitions itself. Measured here — a commit carrying `Refs: CLOUD-178` moved
# that issue Todo -> In Progress, set its assignee, and attached the PR, with no
# write call from the session at all. So the agent's job is not to move the
# issue; it is to supply the key the automation keys on, which is exactly what
# this gate requires. Hand-moving the board is redundant work that also fails in
# a way supplying a branch name does not: a state change is a tracker write, and
# a write can be denied mid-session when the connector re-registers under a
# different name (CLOUD-178). The key travels in git, where nothing can deny it.
#
# What this does NOT gate, stated rather than left as an unmet obligation:
# whether outstanding items actually get written to the issue. That is not a
# computable predicate over any artifact the repo can see. The compensating
# control is that every PR now names an issue, so a durable home always exists
# and "I had nowhere to put it" stops being available.
#
# Fails OPEN on anything it cannot parse, and honours BATTEN_ISSUE_GUARD_BYPASS=1
# — for the genuine exception, a PR that precedes its issue (a drive-by fix
# whose issue is filed from the PR). Bypassing is a decision, not a shortcut.
set -uo pipefail

[ -n "${BATTEN_ISSUE_GUARD_BYPASS:-}" ] && exit 0

raw=$(cat) || exit 0
cmd=$(printf '%s' "$raw" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
[ -n "$cmd" ] || exit 0

# An issue reference anywhere in the command itself (a --body naming CLOUD-178)
# counts, so this is checked against the raw command before quotes are scrubbed.
ISSUE_RE='CLOUD-[0-9]+'
cmd_names_issue=0
printf '%s' "$cmd" | grep -qiE "$ISSUE_RE" && cmd_names_issue=1

# Quoted spans are neutralised so a commit message *mentioning* the command is
# not the command — same treatment as gh-guard and ready-guard.
scrubbed=$(printf '%s' "$cmd" | sed -E "s/'[^']*'/QUOTED/g; s/\"[^\"]*\"/QUOTED/g")

is_pr_open=0
while IFS= read -r seg; do
	read -r -a toks <<<"$seg"
	count=${#toks[@]}
	i=0
	while [ "$i" -lt "$count" ] && [[ ${toks[$i]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do i=$((i + 1)); done
	# Look through wrapper programs so the EFFECTIVE program is judged. In the
	# web sandbox `mise exec -- gh …` is the only working form, so a guard that
	# stops at the wrapper token sees none of the calls that matter.
	while :; do
		case "${toks[$i]:-}" in
		env | command | nice | stdbuf | timeout | xargs | sudo | doas)
			i=$((i + 1))
			while [ "$i" -lt "$count" ] && [[ ${toks[$i]} =~ ^(-|[A-Za-z_][A-Za-z0-9_]*=|[0-9]) ]]; do i=$((i + 1)); done
			;;
		mise)
			case "${toks[$((i + 1))]:-}" in
			exec | x)
				i=$((i + 2))
				while [ "$i" -lt "$count" ] && [[ ${toks[$i]} =~ ^(-|[^ ]*@) ]]; do i=$((i + 1)); done
				;;
			*) break ;;
			esac
			;;
		*) break ;;
		esac
	done
	[ "${toks[$i]:-}" = "gh" ] || continue
	words=()
	for t in "${toks[@]:$((i + 1))}"; do
		case "$t" in -*) ;; *) words+=("$t") ;; esac
	done
	n=${#words[@]}
	j=0
	while [ "$((j + 1))" -lt "$n" ]; do
		case "${words[$j]} ${words[$((j + 1))]}" in
		"pr create" | "pr ready" | "pr ready-for-review") is_pr_open=1 ;;
		esac
		j=$((j + 1))
	done
	# printf '%s\n', not '%s': without the trailing newline `read` returns false
	# on the final segment and the loop body never runs for it.
done < <(printf '%s\n' "$scrubbed" | sed -E 's/(\&\&|\|\||[;|&])/\n/g')

[ "$is_pr_open" = 1 ] || exit 0

deny() {
	jq -n --arg r "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $r
    }
  }'
	exit 0
}

[ "$cmd_names_issue" = 1 ] && exit 0

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
printf '%s' "$branch" | grep -qiE "$ISSUE_RE" && exit 0

# Any commit on this branch that origin/main does not have.
if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
	git log --format='%B' origin/main..HEAD 2>/dev/null | grep -qiE "$ISSUE_RE" && exit 0
fi

deny "Refused: this PR names no CLOUD-<n> issue — not in the branch \`$branch\`, not in any commit on it, not in the command. The board is this repo's observability surface: work that lands without an issue is invisible, and its follow-ups end up in a chat message that dies with the session.

Search the board before writing more code — the issue very often already exists, with measurements that change the fix. Then either name it (branch, commit trailer, or PR body), or create one and name that.

Bypass with BATTEN_ISSUE_GUARD_BYPASS=1 when the PR genuinely precedes its issue."
