#!/usr/bin/env bash
#MISE description="PreToolUse hook body: deny `gh pr create`/`gh pr ready` unless the work names a CLOUD-<n> issue"
#
# The diagnosis this exists to fix, stated plainly because it is about agent
# behaviour and therefore easy to mistake for a memory problem:
#
# Every discipline in this repo that agents reliably follow has a gate that
# fires on a tool call they cannot avoid. `verify` is never skipped because
# `ready-guard` denies `gh pr ready` without its receipt. Memories go through
# the Serena tools because the engine's protected-path gate denies the direct
# write. Commit
# subjects conform because `commit-msg` rejects them.
#
# Every discipline agents reliably SKIP is prose in AGENTS.md with no gate on
# the path they actually take: search the board before starting, move the issue
# in lockstep, leave outstanding items on the issue rather than in a chat
# message that vanishes with the session. `graph-check` gates the board's
# internal coherence, but it is a pure function of stdin someone must choose to
# pipe — nothing makes a session consult the board at all.
#
# So the behaviour tracks the enforcement surface exactly, which is what
# AGENTS.md rule 2 already predicts: "Prose is feedforward only; a log without
# a gate is sensor only." The board section was prose. This is its mechanism.
#
# The predicate: opening or readying a PR requires naming a CLOUD-<n> issue,
# in the branch name, in any commit on the branch, or in the PR body being
# passed. You cannot name an issue you have not looked up, so the gate that
# blocks landing is also what forces the search — at the one moment in the
# lifecycle that cannot be routed around.
#
# What that identifier actually buys, which is more than traceability: the
# tracker's own GitHub integration consumes it and performs the state
# transitions itself, with no write call from the session at all. Supplying the
# key is therefore most of the agent's job, and it is robust in a way a tracker
# write is not — a write can be denied mid-session when the connector
# re-registers under a name no allow rule matches (CLOUD-178), while the key
# travels in git, where nothing can deny it.
#
# But the automation is PUBLISH-SIDE ONLY, and an earlier version of this comment
# got that wrong. It claimed a commit carrying `Refs: CLOUD-178` moved that issue
# Todo -> In Progress. Re-measured on 2026-08-08 (CLOUD-230): a commit carrying
# `Refs: CLOUD-37`, pushed at 04:33:18, moved nothing — the issue went In
# Progress at 04:35:08, eight seconds after `gh pr create` and ~105 seconds after
# that push, and was Done at 04:38:27. The PR event is the trigger, not the
# keyed commit.
#
# That difference is not academic, because it is what the old wording licensed:
# if a commit claims the issue, hand-moving the board is redundant and an agent
# should skip it. It is not redundant. At pull time nothing has been pushed, so
# no key can travel and the automation has nothing to fire on — the claim is the
# agent's to make, by hand, before it writes code. The redundant hand-move the
# board memory warns against is the *publish-side* one, which the integration
# does perform.
#
# What this does NOT gate, stated rather than left as an unmet obligation:
# whether outstanding items actually get written to the issue. That is not a
# computable predicate over any artifact the repo can see. The compensating
# control is that every PR now names an issue, so a durable home always exists
# and "I had nowhere to put it" stops being available.
#
# Fails OPEN on anything it cannot parse, and honours BATTEN_ISSUE_GUARD_BYPASS=1
# — for the genuine exception, a PR that precedes its issue (a drive-by fix
# whose issue is filed from the PR). Bypassing is a decision, not a shortcut.
set -uo pipefail

[ -n "${BATTEN_ISSUE_GUARD_BYPASS:-}" ] && exit 0

raw=$(cat) || exit 0
cmd=$(printf '%s' "$raw" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
[ -n "$cmd" ] || exit 0

# An issue reference anywhere in the command itself (a --body naming CLOUD-178)
# counts, so this is checked against the raw command before quotes are scrubbed.
ISSUE_RE='CLOUD-[0-9]+'
# Quoted spans are neutralised so a commit message *mentioning* the command is
# not the command — same treatment as gh-guard and ready-guard.
scrubbed=$(printf '%s' "$cmd" | sed -E "s/'[^']*'/QUOTED/g; s/\"[^\"]*\"/QUOTED/g")

is_pr_open=0
while IFS= read -r seg; do
	read -r -a toks <<<"$seg"
	count=${#toks[@]}
	i=0
	while [ "$i" -lt "$count" ] && [[ ${toks[$i]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do i=$((i + 1)); done
	# Look through wrapper programs so the EFFECTIVE program is judged. In the
	# web sandbox `mise exec -- gh …` is the only working form, so a guard that
	# stops at the wrapper token sees none of the calls that matter.
	while :; do
		case "${toks[$i]:-}" in
		env | command | nice | stdbuf | timeout | xargs | sudo | doas)
			i=$((i + 1))
			while [ "$i" -lt "$count" ] && [[ ${toks[$i]} =~ ^(-|[A-Za-z_][A-Za-z0-9_]*=|[0-9]) ]]; do i=$((i + 1)); done
			;;
		mise)
			case "${toks[$((i + 1))]:-}" in
			exec | x)
				i=$((i + 2))
				while [ "$i" -lt "$count" ] && [[ ${toks[$i]} =~ ^(-|[^ ]*@) ]]; do i=$((i + 1)); done
				;;
			*) break ;;
			esac
			;;
		*) break ;;
		esac
	done
	[ "${toks[$i]:-}" = "gh" ] || continue
	words=()
	for t in "${toks[@]:$((i + 1))}"; do
		case "$t" in -*) ;; *) words+=("$t") ;; esac
	done
	n=${#words[@]}
	j=0
	while [ "$((j + 1))" -lt "$n" ]; do
		case "${words[$j]} ${words[$((j + 1))]}" in
		"pr create" | "pr ready" | "pr ready-for-review") is_pr_open=1 ;;
		esac
		j=$((j + 1))
	done
	# printf '%s\n', not '%s': without the trailing newline `read` returns false
	# on the final segment and the loop body never runs for it.
done < <(printf '%s\n' "$scrubbed" | sed -E 's/(\&\&|\|\||[;|&])/\n/g')

[ "$is_pr_open" = 1 ] || exit 0

deny() {
	jq -n --arg r "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $r
    }
  }'
	exit 0
}

# Outside a git repo there is no branch and no history to read, so there is
# nothing this guard can honestly judge — fail open rather than deny every PR
# opened from a directory that is not a checkout.
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0

# Any commit on this branch that origin/main does not have.
#
# The log is read into a variable and matched from a here-string, NOT piped into
# `grep -q`. Under `set -o pipefail` grep exits on its first hit, git log takes
# SIGPIPE, and the pipeline's status becomes that signal — so a branch whose
# commits DO name an issue was denied, with the reason claiming no commit named
# one. This gate shipped with that bug and denied its own PR. Same family as the
# false-clean board in `landed-check`.
log=""
if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
	log=$(git log --format='%B' origin/main..HEAD 2>/dev/null || true)
fi

# `grep -o` consumes its whole input rather than exiting on the first hit, so
# piping it is safe under pipefail — the trap documented above applies to
# `-q`/`-m`/`-l` only.
extract() { grep -oiE "$ISSUE_RE" <<<"$1" | tr '[:lower:]' '[:upper:]' | sort -u || true; }

# This branch's own PR, if it has one. Read once and used twice: to exclude
# ourselves from the competitor list below, and — for `gh pr ready`, which
# carries no body at all — as a source of the issue reference and the claim the
# PR already declares on GitHub. Guarded, so a missing `gh` leaves every verdict
# below exactly as it was before this lookup existed.
mine="" self="" mine_text=""
if command -v gh >/dev/null 2>&1; then
	mine=$(gh pr view --json number,title,body 2>/dev/null || true)
	self=$(jq -r '.number // empty' <<<"$mine" 2>/dev/null || true)
	mine_text=$(jq -r '(.title // "") + " " + (.body // "")' <<<"$mine" 2>/dev/null || true)
fi

# Every key this PR MENTIONS, anywhere — the naming check's question, which is
# only "was the board consulted at all".
keys=$(extract "$cmd $branch $log $mine_text")

if [ -z "$keys" ]; then
	deny "Refused: this PR names no CLOUD-<n> issue — not in the branch \`$branch\`, not in any commit on it, not in the command. The board is this repo's observability surface: work that lands without an issue is invisible, and its follow-ups end up in a chat message that dies with the session.

Search the board before writing more code — the issue very often already exists, with measurements that change the fix. Then either name it (branch, commit trailer, or PR body), or create one and name that.

Bypass with BATTEN_ISSUE_GUARD_BYPASS=1 when the PR genuinely precedes its issue."
fi

# --- the duplicate-claim refusal (CLOUD-230) ----------------------------------
#
# Naming an issue proves the board was consulted at *some* point. It does not
# prove nobody else is already on it, and that is a distinct failure with its own
# cost: measured here on 2026-08-08, CLOUD-49 was implemented twice in one cycle
# and one implementation was thrown away. The board carried the claim from
# 04:29:34; the second session had read the issue at startup, while it was still
# Todo, and never re-read it.
#
# Why this check lives on `pr create`/`pr ready` rather than at pull time: no
# artifact exists at pull time for a PreToolUse hook to inspect. Nothing has been
# branched, committed, or pushed, so there is nothing to key on and nothing to
# deny. This is the EARLIEST computable moment, not a complete one — and it is
# only early in wall-clock terms if the draft PR is opened before the work, which
# is what AGENTS.md's board section now asks for. Opened after the work, this
# still fires, but it refuses a duplicate that has already been paid for.
#
# GitHub is the source, deliberately: the tracker has no credential here, but
# `gh` carries the repo PAT (mem:github-access), and an open PR naming the key is
# a stronger claim signal than a column anyway — it means someone has published.
#
# Fails OPEN on everything: no `gh`, no network, a timeout, an unparseable
# response, or a repo we cannot resolve. A guard that cannot reach GitHub must
# never become the reason a session cannot open a PR.
# WHICH issue this PR claims is a narrower question than which it mentions, and
# conflating them is a false positive this guard produced against its own PR —
# twice. A body cites related issues, prior measurements and superseded work as
# evidence; a branch may carry a bundle name naming two issues that landed hours
# ago. Neither is a claim. Only these are, most explicit first:
#
#   1. a closing keyword — `Closes`/`Fixes`/`Resolves CLOUD-<n>` — in the command
#      being run, or in the PR this branch already has. `gh pr ready` carries no
#      body at all, so reading the existing PR is what makes the two calls agree
#      rather than the second one contradicting the first. It OVERRIDES the
#      branch, which is the escape hatch for a branch whose name no longer
#      reflects the work: a bundle branch like
#      `claude/cloud-37-49-config-…` reads as claiming CLOUD-37 forever, and the
#      body is how a PR says otherwise.
#   2. failing that, the branch name — the tracker's own `gitBranchName` shape
#      names the issue being worked, so a branch is a claim.
#   3. failing that, a `Refs:` trailer on a commit.
#
# When none of those resolves, the duplicate check does not run. That is
# deliberate: it would be guessing, and a guard that guesses is one that blocks
# correct work — the failure mode this whole file is written to avoid.
#
# The derivation itself moved to `claimed-keys` when `deferral-check` needed the
# same answer (CLOUD-338): two guards disagreeing about which issue a PR claims
# would be a worse defect than either misfiring, and a second copy is how that
# happens. The precedence above is that script's, documented in its header. The
# command and this PR's own text are the evidence it cannot read for itself.
claimed=$("$(dirname "$0")/claimed-keys" <<<"$cmd $mine_text" 2>/dev/null || true)
[ -n "$claimed" ] || exit 0
[ -n "$mine" ] || command -v gh >/dev/null 2>&1 || exit 0

while read -r key; do
	[ -n "$key" ] || continue
	# `--search` covers title and body; the branch list covers a PR whose only
	# mention of the key is its branch name — which is how the CLOUD-49 duplicate
	# would have presented, since that branch named no issue at all.
	found=$(
		{
			gh pr list --state open --search "$key" --json number,headRefName \
				--jq '.[] | "\(.number) \(.headRefName)"' 2>/dev/null || true
			gh pr list --state open --json number,headRefName \
				--jq '.[] | "\(.number) \(.headRefName)"' 2>/dev/null || true
		} | sort -u
	)
	[ -n "$found" ] || continue

	while read -r number head; do
		[ -n "$number" ] || continue
		# Our own PR is not a competitor — otherwise `pr ready` would deny the
		# very PR it is readying, every time.
		[ "$number" = "$self" ] && continue
		# The competitor is asked the SAME question, through the same authority
		# (CLOUD-378). This used to be a bare mention of the key in the other
		# PR's branch, title or body — so the narrowing above was applied to one
		# side of the comparison and not the other, and a PR citing the key as
		# evidence read as racing it. Measured: #306 (`docs(agents): … at the
		# attribution decision record (CLOUD-268)`) names CLOUD-133 in one row of
		# an evidence table, and refused CLOUD-133's own PR.
		#
		# Every source is passed explicitly because none of them is local: the
		# head branch and the title are the PR's self-declaration, its commit
		# messages carry the `Refs:` trailer, and the body is stdin — evidence
		# that counts only through a closing keyword.
		theirs=$(
			"$(dirname "$0")/claimed-keys" \
				--branch "$head" \
				--title "$(gh pr view "$number" --json title --jq '.title' 2>/dev/null || true)" \
				--log "$(gh pr view "$number" --json commits \
					--jq '.commits | map(.messageHeadline + "\n" + .messageBody) | join("\n")' 2>/dev/null || true)" \
				<<<"$(gh pr view "$number" --json body --jq '.body' 2>/dev/null || true)" 2>/dev/null || true
		)
		# Exact line match: `claimed-keys` emits one uppercased key per line, and
		# `$key` came out of the same function, so no substring rule is needed and
		# CLOUD-4 cannot match CLOUD-49.
		if grep -qxF "$key" <<<"$theirs"; then
			deny "Refused: $key is already claimed by open PR #$number (branch \`$head\`). Two agents on one issue is work that gets thrown away — it has happened in this repo, and the discarded side had already been written and verified before anyone noticed.

Check the board before opening a second front: pipe the issue's payload to \`mise run claim-check\`, and take the frontier from \`mise run graph-check\` rather than a stale snapshot read at session start. If #$number is stale or abandoned, say so on the issue and close it rather than racing it.

Bypass with BATTEN_ISSUE_GUARD_BYPASS=1 when a second PR against one issue is deliberate."
		fi
	done <<<"$found"
done <<<"$claimed"

exit 0
