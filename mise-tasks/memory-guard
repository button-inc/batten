#!/usr/bin/env bash
#MISE description="PreToolUse hook body: deny a file write OR a Bash write shape targeting .serena/memories/, so memories go through the Serena tools"
#
# Wired from .claude/settings.json on BOTH matchers — `Write|Edit|MultiEdit|
# NotebookEdit` and `Bash`. Thin by design: the decision lives in
# `memory-guard-check`, where the guarded path is written once and both branches
# are unit-tested (`tests/memory-guard.bats`).
#
# Serena's write_memory enforces a size ceiling and its rename tool rewrites
# `mem:` references across the other memories. A direct write skips both — the
# whole point of the memory layer becomes advisory the moment it is edited as an
# ordinary file. (Every memory in this repo was written that way before this
# guard existed, which is the failure it encodes; and after it existed, by Bash
# heredoc, which is the one CLOUD-185 closes.)
#
# Fails OPEN on anything it cannot parse, and on BATTEN_MEMORY_GUARD_BYPASS=1 —
# needed when the Serena MCP server is down, since otherwise a disconnected
# server would make memories unwritable by any means.
set -uo pipefail

[ -n "${BATTEN_MEMORY_GUARD_BYPASS:-}" ] && exit 0

raw=$(cat) || exit 0

# Whichever field the event carries. A Write/Edit event has `file_path`, a Bash
# event has `command`; neither present is nothing to judge.
path=$(printf '%s' "$raw" | jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
cmd=$(printf '%s' "$raw" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0

# Invoked BY PATH, never `mise run`: this is a per-tool-call hook, and a mise
# startup here is pure latency — measured 176ms through `mise run` against 18ms
# by path, the whole of the difference being mise resolving its tool graph to
# exec a script that finishes in milliseconds (CLOUD-435). Same reasoning, and
# the same spelling, as `stop-guard`'s sub-checks. The check needs no tool mise
# provides: it is bash and string matching.
check="$(dirname -- "${BASH_SOURCE[0]}")/memory-guard-check"
[ -x "$check" ] || exit 0

if [ -n "$path" ]; then
	reason=$("$check" path "$path" 2>/dev/null) && exit 0
elif [ -n "$cmd" ]; then
	reason=$("$check" command "$cmd" 2>/dev/null) && exit 0
else
	exit 0
fi

[ -n "$reason" ] || exit 0

jq -n --arg r "$reason" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: $r
  }
}'
