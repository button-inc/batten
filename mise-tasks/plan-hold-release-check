#!/usr/bin/env bash
#MISE description="The pure decision behind plan-hold-release: did a HUMAN submit this prompt, or is it a machine turn wearing the same event?"
#
# CLOUD-451. Split from the hook adapter for the reason every `-check` in this
# repo is: the predicate becomes directly callable and directly testable, and the
# envelope table is written exactly once.
#
# The measurement that forced it is in `plan-hold-release`'s header — a
# background task's completion notification arrives as a `UserPromptSubmit` and
# released a hold 15 seconds after it was armed, with nobody having typed.
#
# THE TABLE IS SHAPES, NOT SENDERS. Nothing in the payload says "a person wrote
# this", so the question has to be answered from the envelope the harness wraps
# machine turns in. Two shapes cover every one observed: a tag at the very start
# (`<task-notification>`, `<github-webhook-activity>`, `<system-reminder>`,
# `<untrusted_external_data>`) and a bracketed banner (`[SYSTEM NOTIFICATION …`).
# Matching the OPENING rather than searching the body is the point: a human
# quoting a notification is still a human, and a substring search would classify
# them as a machine — which is the expensive direction.
#
# Exit 0 release / 1 hold. There is no exit 2: an unreadable payload is not an
# error to report, it is simply not evidence that a person is there, and this
# gate's whole bias is that absence of evidence holds.
#
# Reads stdin, writes nothing. Pointer-only in the strongest form there is —
# the prompt is classified and never echoed, counted, or summarised.
set -uo pipefail

raw=$(cat 2>/dev/null) || exit 1
[ -n "$raw" ] || exit 1

prompt=$(printf '%s' "$raw" | jq -r '.prompt // empty' 2>/dev/null) || exit 1

# A payload with no prompt field at all is not evidence of a person. Older or
# other harnesses may spell it differently; when they do, this holds rather than
# guessing, and the hold's cap is what bounds the cost of being wrong.
[ -n "$prompt" ] || exit 1

# Leading whitespace and blank lines are the harness's formatting, not the
# sender's identity, so the shape is judged from the first non-space character.
trimmed=${prompt#"${prompt%%[![:space:]]*}"}
[ -n "$trimmed" ] || exit 1

case "$trimmed" in
# Tag-shaped: every machine envelope observed opens with one, and a person who
# genuinely begins a message with a `<` pays only a sleeper that caps itself.
'<'*) exit 1 ;;
# Banner-shaped, in the two spellings the harness uses.
'[SYSTEM'* | '[Request interrupted'*) exit 1 ;;
esac

exit 0
