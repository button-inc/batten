#!/usr/bin/env bash
#MISE description="Build the release binary for a target and stage a distributable archive in dist/"
#
# The distribution build, defined ONCE so the release workflow and a maintainer
# run byte-identical commands (AGENTS.md: "CI runs the exact same mise tasks you
# run locally"). The workflow calls this per matrix target and never
# re-implements the build, the profile, or the archive name.
#
# House-style §12 wants a single static binary, installable binary-first. Before
# this task nothing in the repo ever produced one: `cross-check` runs `cargo
# check` (codegen-to-metadata, no linking), which proves the code compiles for a
# target but yields nothing runnable. This is the step that yields the artifact.
#
# The archive name is a contract, not a convenience: CLOUD-65's `cargo binstall`
# path resolves a release asset by name, so the shape below (name-version-target)
# is what makes these assets consumable later. It is asserted in tests/dist.bats.
set -euo pipefail

readonly BIN=batten
readonly OUT_DIR=dist

# How to invoke the compiler for a target: cargo, cross, or zigbuild.
#
# `rustup target add` installs only the standard library; the LINKER is what
# actually blocks a cross-build, so each non-native target needs one supplied:
#
#   cargo     the host target — the system linker already works.
#   cross     (cross-rs) builds inside a per-target container carrying that
#             target's linker and sysroot. Used for the other Linux targets and
#             for Windows.
#   zigbuild  (cargo-zigbuild) uses zig as the linker. zig ships the Darwin
#             linker support, so a LINUX host can emit a Mach-O binary with no
#             Apple SDK and no macOS runner — and zig writes the ad-hoc code
#             signature that Apple Silicon requires before it will exec an
#             arm64 binary at all.
BUILD_TOOL="${DIST_BUILD_TOOL:-cargo}"

usage() {
	cat >&2 <<-EOF
		usage: mise run dist <target>

		  <target>  a Rust target triple, e.g. x86_64-unknown-linux-gnu.
		            Must already be installed (rustup target add <target>).

		Builds ${BIN} with --profile dist and writes an archive to ${OUT_DIR}/.
		Prints \`archive=<path>\` and \`binary=<path>\` on stdout — KEY=VALUE so the
		release workflow can append it to \$GITHUB_OUTPUT unchanged.
	EOF
}

# The crate version is read from the workspace manifest, never passed in: a
# version argument could disagree with what cargo actually builds, and an
# archive whose name lies about its contents is worse than no archive.
crate_version() {
	local version
	version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n1)
	if [ -z "$version" ]; then
		echo "dist: could not read version from Cargo.toml" >&2
		return 1
	fi
	printf '%s' "$version"
}

# Windows targets produce a .exe and ship as .zip; everything else is a bare
# binary in a .tar.gz. Keyed off the target triple rather than the host, so a
# cross-build names its archive for the platform it RUNS on, not the one it was
# built on.
is_windows_target() {
	case "$1" in
	*-windows-*) return 0 ;;
	*) return 1 ;;
	esac
}

# The asset name. Kept in one function because it is the contract CLOUD-65 reads.
archive_stem() {
	printf '%s-v%s-%s' "$BIN" "$1" "$2"
}

# The archive extension for a target, keyed off the same predicate as the stem.
# A function rather than an inline conditional in `main` because the naming
# contract now has a second reader: `install.sh` resolves an asset by name and
# `mise run install-check` proves the two agree by calling BOTH — which it can
# only do if the extension rule is callable rather than embedded in the build.
archive_ext() {
	if is_windows_target "$1"; then
		printf '.zip'
	else
		printf '.tar.gz'
	fi
}

main() {
	local target="${1:-}"
	case "$target" in
	-h | --help)
		usage
		return 0
		;;
	# The stem, without building. `mise-tasks/sbom-binary` names its asset from
	# this rather than re-spelling `archive_stem`, so the naming contract
	# CLOUD-65's install path reads stays decided in one place — the same reason
	# `sbom --names` exists for the platform-independent documents.
	--stem)
		if [ -z "${2:-}" ]; then
			usage
			return 1
		fi
		archive_stem "$(crate_version)" "$2"
		printf '\n'
		return 0
		;;
	"")
		usage
		return 1
		;;
	esac

	local version stem bin_name archive
	version=$(crate_version)
	stem=$(archive_stem "$version" "$target")

	if is_windows_target "$target"; then
		bin_name="${BIN}.exe"
	else
		bin_name="${BIN}"
	fi
	archive="${OUT_DIR}/${stem}$(archive_ext "$target")"

	# --locked so a release build resolves the exact dependency versions the
	# lockfile pins; a release that silently floated a dependency is not the
	# artifact CI tested.
	# `cargo auditable` on the two wrappers it is PROVEN to compose with, and not
	# on `cross` (CLOUD-263). It embeds the resolved dependency graph in a `dep-v0`
	# linker section, which is the only reason a syft scan of the shipped binary
	# recovers anything at all — measured, a plain build yields zero rust-crate
	# packages and an auditable one 85, through `strip = true`.
	#
	# THE `cross` LEGS ARE DELIBERATELY UNWRAPPED. Composition there is unmeasured,
	# not refuted: `cross` compiles inside a container carrying its own toolchain,
	# and no Docker daemon was available to probe it. This matrix shipped six
	# consecutive releases with zero binaries (CLOUD-258), so an unproven build
	# wrapper does not enter it on inference — `mise-tasks/sbom-binary` is only
	# asked for the legs that are proven, and the DoD's "every archive whose leg
	# composes" is what absorbs the narrowing.
	case "$BUILD_TOOL" in
	# cargo-zigbuild replaces the `build` verb rather than wrapping it; `auditable`
	# wraps rustc rather than the subcommand, so the two compose.
	zigbuild) cargo auditable zigbuild --locked --profile dist --target "$target" --bin "$BIN" >&2 ;;
	cargo) cargo auditable build --locked --profile dist --target "$target" --bin "$BIN" >&2 ;;
	cross) cross build --locked --profile dist --target "$target" --bin "$BIN" >&2 ;;
	*)
		echo "dist: DIST_BUILD_TOOL must be cargo, cross, or zigbuild, got '${BUILD_TOOL}'" >&2
		return 1
		;;
	esac

	local built="target/${target}/dist/${bin_name}"
	if [ ! -f "$built" ]; then
		echo "dist: expected a binary at ${built}, found none" >&2
		return 1
	fi

	mkdir -p "$OUT_DIR"
	rm -f "$archive"
	# Both forms archive the binary at the root, never under target/<triple>/dist/,
	# so extracting yields `batten` beside the user rather than a directory tree.
	# An absolute destination, because zip is run from the build directory.
	local abs_archive="${PWD}/${archive}"
	if is_windows_target "$target"; then
		(cd "$(dirname "$built")" && zip -q "$abs_archive" "$bin_name")
	else
		tar -czf "$archive" -C "$(dirname "$built")" "$bin_name"
	fi

	# stdout is the answer: pointers to the artifacts, never their bytes. Emitted
	# as KEY=VALUE lines so the release workflow can append this straight to
	# $GITHUB_OUTPUT — the per-target binary suffix is decided HERE, once, rather
	# than re-derived by a shell conditional in YAML that could disagree.
	echo "archive=$archive"
	echo "binary=$built"
}

main "$@"
