#!/usr/bin/env bash
#MISE description="Which CLOUD-* issues did a release tag ship? Resolves refs from the tag's commit range; cross-checks piped board payloads for the ones still In Review"
#
# CLOUD-174. `Done` on this board means **released**, and Linear's GitHub
# integration cannot supply that transition: it triggers on PR events, and "a
# release tag now contains this commit" is not one. No setting fixes it — the
# trigger does not exist. So the last transition of every issue was manual and
# reliably forgotten; CLOUD-29 sat in In Review after shipping in v0.0.14.
#
# This is the predicate half. Per the issue's own split, the Linear write is the
# *effect* and the extraction is the *predicate*, so what is gated and tested
# here is "which refs did this tag ship, and which of them are still In Review".
# The write stays with the caller, which is the agents-fetch-gates-decide shape
# `graph-check` and `ready-lint` already use: no tracker credential exists, so an
# agent pipes the board in and performs the moves this names.
#
# Source of truth is git — the tag's commit range. There is deliberately no
# second list of what shipped.
#
#   mise run released v0.0.14                    # refs the tag shipped
#   mise run released v0.0.14 < payloads.json    # …restricted to In Review issues
#
# Pointer-only (rule 4): identifiers and target state, never issue bodies. Output
# is sorted, so re-running is byte-stable and diffable.
#
# Idempotent by construction: it reports, it does not mutate. Running it twice
# against the same tag prints the same thing.
#
# It needs TAGS, which a default CI checkout does not fetch — anything wiring
# this into the release path must fetch them first, or every tag will look
# absent.
#
# SHIPPING A REF IS NECESSARY FOR Done, NOT SUFFICIENT (CLOUD-257). The range is
# resolved from commit messages, so this answers "did a tag ship a commit naming
# this issue" — the same signal `landed-check`'s header warns about on the Todo
# edge, and a commit can equally continue, document, cite or defer. The cost is
# higher here because Done is terminal and nothing re-opens it. Measured: a sweep
# reported 25 movable, of which CLOUD-108 (whose body says DO NOT CLOSE UNTIL THE
# MATRIX HAS RUN GREEN) and CLOUD-202 (a five-item port with item 5 undone) were
# not done; one was moved on that word and reverted.
#
# Remaining scope is not computable from git and this does not try. The tractable
# half is the REFUSAL: an issue that says it is not done is reported HELD and the
# run exits 1, so a sweep cannot close it. A literal marker, matched exactly —
# never a judgement about whether prose means "not done", which would make a gate
# out of a classification (non-negotiable 3).
set -euo pipefail

# The marker an issue puts in its own body to hold itself open. One string, and
# it is stated here rather than in each issue's prose, so adding a hold is
# copying a token rather than inventing a phrasing this has to recognise.
HOLD_MARKER='DO-NOT-CLOSE'

tag="${1:-}"
if [ -z "$tag" ]; then
	echo "::error:: usage: mise run released <tag> [< get_issue payloads on stdin]" >&2
	exit 2
fi

if ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1; then
	echo "::error:: no such tag: $tag. A tag that does not exist is a caller error, not an empty release." >&2
	exit 2
fi

# The range is "new in this tag": the previous tag reachable from it, exclusive.
# `describe` walks the commit graph, so it answers "the release this one follows"
# topologically. Creation date is the obvious alternative and is wrong — tags cut
# seconds apart sort arbitrarily, which made this resolve to the whole history
# and report every issue ever shipped as new in the latest tag.
#
# For the FIRST tag there is no predecessor, so the range is the whole history —
# correct, since everything in it did ship there.
prev=$(git describe --tags --abbrev=0 "$tag^" 2>/dev/null || true)
if [ "$prev" = "$tag" ] || [ -z "$prev" ]; then
	range="$tag"
else
	range="$prev..$tag"
fi

# The repo requires a CLOUD-<n> reference on the work (issue-guard), so commit
# subjects and bodies are where the mapping lives. No parallel registry.
refs=$(git log --format='%B' "$range" 2>/dev/null | grep -oE 'CLOUD-[0-9]+' | sort -u || true)

# No stdin, or an empty one: report the refs and stop. This is the form that
# answers "what did this tag ship?" without needing the board at all. It can only
# use the grep — the second path below needs a payload to read a commit from.
if [ -t 0 ] || ! payload=$(cat) || [ -z "${payload//[[:space:]]/}" ]; then
	if [ -z "$refs" ]; then
		# A release of pure chore/release commits ships no issue. That is a clean
		# outcome, not a failure — exiting non-zero would break the release path.
		echo "released: $tag ($range) references no CLOUD-* issue"
	else
		echo "released: $tag ($range) shipped:"
		# shellcheck disable=SC2086  # word-splitting is the point: one id per line
		printf '  %s\n' $refs
	fi
	exit 0
fi

# With payloads, narrow to the issues this tag actually moves. Accept a JSON
# array or a concatenated stream, the same shapes `graph-check` accepts.
if ! issues=$(jq -sc 'if length == 1 and (.[0] | type == "array") then .[0] else . end' <<<"$payload" 2>/dev/null) ||
	! jq -e 'all(.[]; has("id") and has("status"))' <<<"$issues" >/dev/null 2>&1; then
	echo "::error:: stdin is not a set of get_issue payloads (need id and status per issue)" >&2
	exit 2
fi

# THE SECOND WAY IN (CLOUD-260). The grep above rests on a premise that does not
# hold retroactively: issue-guard makes the ref mandatory *now*, so work that
# landed before that discipline carries none, and no tag can ever name it. Four
# issues sat In Review permanently for exactly this reason — CLOUD-190's own body
# says "backfilled: landed before the every-change-carries-its-issue discipline;
# this issue is the key for the attached PR" — with landed work behind merged PRs
# and zero mentions in main's entire history.
#
# So an issue may also supply a `commit`, and containment in this tag's range
# decides it: an ancestor of the tag and not of its predecessor is exactly "new in
# this tag", the same range the grep uses. That is an exit code over git objects,
# not a registry and not a classification.
#
# The FETCH moves to the caller, not the network into this gate: PR -> commits is
# not recoverable locally under fast-forward landing, and this task's defining
# property is that it is a pure function of stdin plus git. Same
# agents-fetch-gates-decide split as graph-check, ready-lint and landed-check.
#
# A malformed or unknown sha is ignored rather than fatal — it is supplementary
# evidence, and a caller that supplies none must behave exactly as before.
by_commit=""
while IFS= read -r pair; do
	[ -n "$pair" ] || continue
	id="${pair%% *}"
	sha="${pair#* }"
	git rev-parse -q --verify "${sha}^{commit}" >/dev/null 2>&1 || continue
	git merge-base --is-ancestor "$sha" "$tag" 2>/dev/null || continue
	if [ -n "$prev" ] && [ "$prev" != "$tag" ]; then
		# Already shipped in an earlier tag, so not new in this one.
		! git merge-base --is-ancestor "$sha" "$prev" 2>/dev/null || continue
	fi
	by_commit="$by_commit $id"
done <<<"$(jq -r '.[] | select((.commit // "") != "") | "\(.id) \(.commit)"' <<<"$issues" 2>/dev/null || true)"

# One list, deduped and sorted, so the report stays byte-stable however an issue
# was matched. Matching twice is not a finding — it is the ordinary case for work
# that both carries its ref and supplies a commit.
# shellcheck disable=SC2086  # word-splitting is the point: one id per line
refs=$(printf '%s\n' $refs $by_commit | sort -u)

if [ -z "${refs//[[:space:]]/}" ]; then
	echo "released: $tag ($range) references no CLOUD-* issue"
	exit 0
fi

movable=0
skipped=0
held=0
for ref in $refs; do
	status=$(jq -r --arg id "$ref" '.[] | select(.id == $id) | .status' <<<"$issues" | head -n1)
	# An issue this tag shipped but which was not piped in is not a finding: the
	# caller chose the closure to judge, exactly as graph-check does.
	[ -n "$status" ] || continue
	body=$(jq -r --arg id "$ref" '.[] | select(.id == $id) | .description // ""' <<<"$issues" | head -c 100000)
	if [ "$status" = "In Review" ] && [ "${body#*"$HOLD_MARKER"}" != "$body" ]; then
		echo "  $ref  HELD — the issue holds itself open"
		held=$((held + 1))
	elif [ "$status" = "In Review" ]; then
		echo "  $ref  In Review -> Done"
		movable=$((movable + 1))
	else
		# Already Done, or somewhere else entirely. Reported, never touched —
		# a state this does not understand is the caller's to reconcile.
		echo "  $ref  $status (left alone)"
		skipped=$((skipped + 1))
	fi
done

if [ "$held" != 0 ]; then
	echo "released: $tag ($range) — $movable to move, $skipped left alone, $held HELD"
	echo "::error:: $held issue(s) shipped in $tag but carry \`$HOLD_MARKER\`. Shipping a ref is necessary for Done, not sufficient — resolve the hold or strike the marker before moving them." >&2
	exit 1
fi

echo "released: $tag ($range) — $movable to move, $skipped left alone"
