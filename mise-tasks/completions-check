#!/usr/bin/env bash
#MISE description="Gate: the committed shell completions match the ones the binary emits from its surface (CLOUD-27)"
#
# House style §11: completions are a *derivation* of the command spec, "so the
# shipped binary and the generated docs can never drift." A derivation nothing
# diffs is a copy, and a copy drifts silently — the committed script keeps
# advertising a flag the surface dropped, or misses one it gained, and the first
# person to notice is a user whose tab-completion lies.
#
# DoR §4 names this shape directly: anything derived from the spec is
# regenerated by its generator and diffed byte-for-byte against the committed
# copy. This is that diff.
#
# The regeneration is deliberately the same command `mise run completions` runs
# — via the binary's stdout-only `generate` verb — so a green gate is proof that
# re-running the documented refresh is a no-op, not merely that two files happen
# to agree.
set -euo pipefail

cd "${COMPLETIONS_ROOT:-$(git rev-parse --show-toplevel)}"

# Emit into a scratch dir rather than over the committed files: a gate that
# rewrites the tree it is judging cannot fail twice, and would launder drift
# into a "clean" second run.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

violations=0
report() { # pointer-only (rule 4): file:line rule-id
	echo "$1 $2" >&2
	violations=$((violations + 1))
}

for shell in bash zsh fish; do
	committed="completions/batten.$shell"
	if [ ! -f "$committed" ]; then
		report "$committed:0" "completions-missing"
		continue
	fi
	if ! cargo run --quiet -p batten -- generate completions --shell "$shell" >"$scratch/batten.$shell"; then
		echo "::error:: completions-check: the binary could not emit $shell completions" >&2
		exit 1
	fi
	# Pointer-only: the gate names the file that drifted, never the diff body —
	# the remedy is always the same one command, so the bytes add nothing.
	cmp -s "$committed" "$scratch/batten.$shell" || report "$committed:0" "completions-drift"
done

if [ "$violations" -ne 0 ]; then
	echo "::error:: completions-check: $violations completion script(s) differ from the surface; run 'mise run completions'" >&2
	exit 1
fi
echo "completions-check: every committed completion matches the surface"
