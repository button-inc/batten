#!/usr/bin/env bash
#MISE description="Gate: every mem: reference in tracked markdown resolves to a real memory, and every memory is addressable by its name (CLOUD-183)"
#
# The checked-in memories are a knowledge graph navigated by mem: references,
# and nothing gated its edges: the reference tooling's own integrity check is
# advisory by construction (read-only, always exits 0), and its rename command
# is the only thing that keeps referrers in sync — so a `git mv` of a memory,
# or any direct write, silently orphans every reference to it. A graph whose
# edges can dangle silently is prose pretending to be structure (rule 2).
#
# A pure function of the tracked tree: no tool dependency, so it gates the
# damage no matter what performed the rename. The reference syntax
# (mem: + [A-Za-z0-9_/-]) is restated from the tooling's matcher HERE AND ONLY
# HERE — if upstream's syntax changes, this is the one line to update.
set -euo pipefail

cd "${MEMCHECK_ROOT:-$(git rev-parse --show-toplevel)}"
memories=".serena/memories"
# The always-loaded surface, whose memory table is the routing table this gate
# joins against. `batten.toml`'s `[budget.instructions]` names the same file as
# the counted always-loaded set; naming it here too is deliberate rather than a
# second authority — parsing TOML in shell to learn a constant would buy a
# dependency and no accuracy.
index="AGENTS.md"
# The upstream convention template, exempt from BOTH the referrer scan below and
# the index join above it, on the same ground: it is shipped by the tooling, and
# its examples describe memories that deliberately do not exist here. Written
# once so the two exemptions cannot come to disagree.
template="$memories/memory_maintenance.md"

violations=0
report() { # pointer-only: file:line rule-id (name)
	echo "$1 $2" >&2
	violations=$((violations + 1))
}

# --- graph root ---------------------------------------------------------------
#
# The reference model makes mem:core the discovery entry point; a graph with no
# root is only findable by directory listing.
[ -f "$memories/core.md" ] || report "$memories/core.md:0" "memory-root-missing"

# --- routing-table membership (CLOUD-291) --------------------------------------
#
# The index names each memory and the trigger to read it, and a memory states no
# trigger of its own by design — that is the referring document's job. So a memory
# with no row has no trigger ANYWHERE and is reachable only by listing the
# directory: `workflow/agent-fanout`, the repo's only concurrency cap, sat in
# exactly that state while a fan-out ran with no bound.
#
# The other conjuncts check references OUT of documents. An orphan is not a broken
# link, so none of them fires on this, and a referencedness check written against
# `mem:` mentions could not work either — the graph root carries zero outgoing
# references and would fail the tree it governs.
#
# So the predicate is a SET DIFFERENCE, evaluated in the bijection loop below
# rather than in a second walk that could drift from it: tracked memory names,
# minus the index rows read here, minus the template.
#
# A row is a table row whose first cell is a backticked name in the reference
# charset. The `.claude/rules/` table in the same file matches nothing (its cells
# carry a `.`), and would be harmless if it did: a surplus name subtracts nothing
# from the memory set.
#
# An absent index is REPORTED, never a silent skip — the same shape as the missing
# graph root above. A gate that goes quiet when its input disappears is a false
# green, and this predicate is one that goes quiet exactly when it is satisfied.
[ -f "$index" ] || report "$index:0" "memory-index-missing"
# `[:blank:]` and not `[:space:]`: the latter deletes the newlines too, folding
# every row into one blob that matches no name.
# shellcheck disable=SC2016  # the backticks are literal markdown, not a subshell
indexed=$(grep -oE '^\|[[:blank:]]*`[A-Za-z0-9_/-]+`' "$index" 2>/dev/null | tr -d '|`[:blank:]' || true)

# --- name bijection -----------------------------------------------------------
#
# A memory must be addressable AS WRITTEN. The tooling silently strips a
# trailing .md from names, so foo.md.md lists as "foo.md" and can never be
# addressed by its own filename; charset outside [A-Za-z0-9_/-] cannot be
# referenced at all, since the reference matcher stops at the first foreign
# character.
while IFS= read -r f; do
	name="${f#"$memories"/}"
	name="${name%.md}"
	case "$name" in
	*.md) report "$f:0" "memory-name-shadowed (strips to ${name%.md})" ;;
	esac
	# The index join is an `elif`: a name that cannot be referenced cannot appear
	# in the index either, so reporting it unindexed as well would say the same
	# thing twice. The name is compared AS THE INDEX WRITES IT — `workflow/x`, not
	# a basename — which is what keeps a memory in a subdirectory from being
	# reported for its path shape.
	if ! grep -qE '^[A-Za-z0-9_/-]+$' <<<"$name"; then
		report "$f:0" "memory-name-unreferencable"
	elif [ "$f" != "$template" ] && ! grep -qxF "$name" <<<"$indexed"; then
		report "$f:0" "memory-unindexed ($name)"
	fi
done < <(git ls-files "$memories/*.md" "$memories/**/*.md" | sort -u)

# --- stale references ---------------------------------------------------------
#
# Every mem:NAME in tracked markdown must resolve — AGENTS.md and the rule
# files reference memories too, so the whole tracked tree is scanned, not only
# the memories. memory_maintenance.md is excluded as a referrer: it is the
# shipped convention template, and its examples reference memories that
# deliberately do not exist here (the tooling's own scanner excludes it too).
while IFS=: read -r file line ref; do
	[ -n "$ref" ] || continue
	name="${ref#mem:}"
	[ -f "$memories/$name.md" ] || report "$file:$line" "mem-ref-stale ($name)"
	# CHANGELOG.md is excluded with the template: release-plz owns it, so a stale
	# reference there could only be fixed by hand-editing a generated file.
	#
	# Bare `xargs` below, with no `--no-run-if-empty` (CLOUD-282): the short form
	# of that flag is a GNU extension BSD xargs did not carry until recently. It
	# bought nothing here — the `/dev/null` sentinel argument means a zero-file
	# invocation still runs `grep` against one unmatchable file, which prints
	# nothing and exits 1, which is exactly what the flag was suppressing.
	# `no-gnu-xargs-r` in batten.toml keeps it out; the literal is not spelled
	# here because that row is a substring rule over this directory.
done < <(git ls-files '*.md' ':!:tests/bats' ':!:CHANGELOG.md' |
	grep -vxF "$template" |
	xargs grep -noE 'mem:[A-Za-z0-9_/-]+' /dev/null 2>/dev/null | sort -u)

if [ "$violations" -ne 0 ]; then
	echo "::error:: memories-check: $violations violation(s) — the memory graph has dangling edges" >&2
	exit 1
fi
echo "memories-check: memory graph coherent"
