#!/usr/bin/env bash
#MISE description="PreToolUse hook body: deny an edit inside the repo when this branch carries no claim receipt"
#
# CLOUD-272. The board discipline has two halves and only one was gated.
# `issue-guard` refuses `gh pr create` without a `CLOUD-<n>`, and `claim-check`
# answers whether an issue is pullable — but nothing sat between *discovering*
# work and *editing files* for it. An agent that found a defect mid-session could
# write the fix, run the gate, and commit with every guard green, because the
# first guard in the path fired at publish time.
#
# Measured on CLOUD-270: a defect was found, implemented, gated, committed and
# pushed before any issue existed. The issue was authored afterwards, which
# inverts the Definition of Ready — a Ready block written from a finished diff
# can only describe it. The cost was real: `ready-lint` failed that block on
# `bump-disagrees-with-type`, a specification error a pre-implementation run
# would have caught for free, and which no amount of green CI could surface,
# because CI cannot fail a correct implementation of the wrong thing.
#
# THE NAIVE FORM, RULED OUT FIRST. "Refuse an edit when no `CLOUD-<n>` is In
# Progress and assigned" needs live board state, and no tracker credential
# exists in a hook — `claim-check` is a pure function of piped stdin for exactly
# that reason. So it is not computable at the moment of the edit at all, before
# any question of its false-positive rate.
#
# THE RECEIPT INVERTS THE DEPENDENCY. The board read already happened, by the
# agent, when it ran `claim-check`. The receipt is that read's local durable
# trace, which is what makes this guard a pure function of the filesystem: a
# file exists for this branch, or it does not.
#
# WHY THE FALSE-POSITIVE RATE STAYS SURVIVABLE, structurally rather than by
# tuning — a guard with false positives gets bypassed, and a bypassed guard
# enforces nothing:
#
#   * Git-ignored paths and paths outside the repo are never judged. That is the
#     scratch-work half, closed honestly rather than by guessing.
#   * The receipt is per BRANCH and minted once, so the cost is one
#     `claim-check` run per unit of work, not one per edit.
#
# A new-but-not-yet-tracked file inside the repo IS judged: opening a feature
# file is the first edit this exists to catch, and exempting untracked paths
# would leave the hole open in its commonest form.
#
# Keyed by branch and not by commit SHA, unlike `ready-guard`'s receipts, and
# the difference is the design rather than an inconsistency. A `verify` receipt
# *should* expire the moment an amend or a rebase mints a new SHA, because it
# attests to a property of those exact bytes. A claim attests to a decision about
# an ISSUE, which every commit on the branch continues to serve.
#
# Fails OPEN on anything it cannot establish, and on BATTEN_CLAIM_GUARD_BYPASS=1.
set -uo pipefail

[ -n "${BATTEN_CLAIM_GUARD_BYPASS:-}" ] && exit 0

raw=$(cat) || exit 0
path=$(printf '%s' "$raw" | jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
[ -n "$path" ] || exit 0

# Outside a checkout there is no branch and no receipt store, so there is
# nothing this guard can honestly judge.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$root" ] || exit 0
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# A detached HEAD has no branch to key a claim on. Refusing here would deny every
# edit during a rebase conflict resolution — the one moment the workflow contract
# says a human decision is required.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
[ -n "$branch" ] || exit 0

# Resolve the target against the repo root so a relative path is judged the same
# as an absolute one. `-m` because the file need not exist yet — a brand-new
# feature file is precisely the case this guard is for.
absolute=$(realpath -m -- "$path" 2>/dev/null) || exit 0
[ -n "$absolute" ] || exit 0
canonical_root=$(realpath -m -- "$root" 2>/dev/null) || exit 0

# Outside the repository: not this repository's policy to enforce.
case "$absolute" in
"$canonical_root" | "$canonical_root"/*) ;;
*) exit 0 ;;
esac

relative=${absolute#"$canonical_root"/}

# Anything git ignores is scratch. `check-ignore` is the authority rather than a
# reimplementation of the ignore rules, so a repo's own `.gitignore` decides.
git check-ignore -q -- "$absolute" 2>/dev/null && exit 0

# Never judge writes into git's own directory: receipts, hooks and index state
# are the machinery, not the work.
case "$relative" in
.git/*) exit 0 ;;
esac

# The receipt. One file per branch, written by `claim-check` on its pullable
# path. Slashes are the only character that cannot appear in a filename, and a
# branch name is otherwise safe here — this must match `claim-check`'s spelling.
receipt="$git_dir/batten-receipts/claim.${branch//\//-}"
[ -f "$receipt" ] && exit 0

jq -n --arg b "$branch" --arg p "$relative" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: (
      "Refused: branch \"" + $b + "\" carries no claim receipt, so `" + $p +
      "` is work with no ticket. The board is this repo'"'"'s observability surface, and its two halves were unevenly gated: `issue-guard` fires at `gh pr create`, which is the END of the work. This is the other half.\n\nPull the issue first: search the board (`mise run graph-check` prints the ready frontier), then pipe the issue'"'"'s `get_issue` payload to `mise run claim-check`. It exits non-zero if someone is already on it, and mints this receipt if not. Then move it Todo -> In Progress and assign yourself — the tracker automation will not, since it fires on the PR event.\n\nScratch work is not gated: anything git-ignored, and anything outside the repo, is never judged. Bypass with BATTEN_CLAIM_GUARD_BYPASS=1 when taking over a stale claim deliberately."
    )
  }
}'
