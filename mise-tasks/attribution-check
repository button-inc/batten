#!/usr/bin/env bash
#MISE description="Gate: no appeal-to-authority attribution in tracked files — an adopted practice is justified on this repo's terms, not by who else does it"
#
# The rule this enforces lives in mem:prior-art-and-issue-hygiene: once a practice
# is adopted it is ours, and a comment must state the rule and the evidence, not
# name a third party. "As <project> does" is unevaluable by a reader and survives
# neither that project changing its mind nor being wrong.
#
# Only the enforceable subset is gated: a bare mention of an external project in
# prose. A *coordinate* — the same name inside a URL, a package path, or a tool
# pin — is how we address a dependency and is explicitly allowed, so lines
# carrying one are exempt.
#
# Deliberately narrow. A guard with false positives gets bypassed, and a bypassed
# guard enforces nothing; the residual judgement stays with the reviewer.
set -uo pipefail

# Sources whose *practice* we have surveyed. Only these carry appeal-to-authority
# risk; a tool we merely invoke by name (release-plz, shellcheck, taplo) is
# vocabulary, not an authority, and is not listed. Add a name here when a survey
# adds a source.
NAMES='jdx|semgrep|opengrep'

# Lines that address a dependency rather than appeal to one: a URL, a package
# path, a tool pin, a pinned action. These are how we name what we depend on.
COORDINATE='https?://|package://|aqua:|ubi:|npm:|pipx:|github\.com|\.dev|submodule|amends|uses:|@[0-9a-f]{40}|^[^:]*\.lock:'

fail=0
while IFS= read -r hit; do
	grep -qE "$COORDINATE" <<<"$hit" && continue
	[ "$fail" = 0 ] && echo "::error:: appeal-to-authority attribution found. State the rule and the evidence in this repo's terms instead (see mem:prior-art-and-issue-hygiene):" >&2
	printf '  %s\n' "$hit" >&2
	fail=1
done < <(
	git ls-files -z \
		':!:.serena/memories/prior-art-and-issue-hygiene.md' \
		':!:mise-tasks/attribution-check' \
		':!:tests/attribution-check.bats' |
		xargs -0 grep -nEI "$NAMES" 2>/dev/null
)

[ "$fail" = 0 ] && echo "attribution-check: no appeal-to-authority attribution in tracked files"
exit "$fail"
