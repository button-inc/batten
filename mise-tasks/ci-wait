#!/usr/bin/env bash
#MISE description="Block until every check-run on HEAD reaches a terminal state, then report conclusions (exit 1 if any check did not succeed)"
#
# Workflow-contract step 4: after `gh pr ready`, CI is confirmed by a continuous
# poll, never by waiting on a webhook — webhooks drop successes, so silence is
# never green. `land` depends on this task, so a red PR cannot be landed. Run it
# backgrounded. Deliberately unbounded: the exit condition is "checks reached
# terminal", which always happens, and a wall-clock timeout would only
# reintroduce the VM-reap gap it was meant to close.
#
# The poll is conditional. Each request carries the previous response's ETag as
# `If-None-Match`; when nothing has changed GitHub answers 304 Not Modified with
# no body, and a 304 does not count against the rate limit. Measured here: three
# consecutive conditional requests left `X-RateLimit-Used` unchanged. That is
# what makes a short interval affordable — an unconditional 20s poll spent a
# request every 20s to usually learn nothing, so the interval had to stay long
# and the news arrived late.
#
# WHAT GREEN MEANS IS NOT DECIDED HERE. `checks-green` owns that predicate —
# terminality over the named required set, `skipped` read as "not an answer"
# only where it is required, absent distinguished from skipped (CLOUD-327, and
# its own header carries the reasoning). This task is the poll around it, and
# the split is what let `auto-release-land.yml` stop carrying a second, weaker
# copy of the same judgement (CLOUD-346). `land`'s lap re-fires the ready, which
# is what replaces a draft's skips.
#
# Measured against this endpoint: ~260ms network round trip warm, ~130ms of `gh`
# process startup, ~470ms for the whole conditional call. The sleep is therefore
# not what sets the pace — the round trip is — and a 1s interval gives a ~1.5s
# cycle, roughly 40 requests a minute against a secondary limit measured in
# hundreds of points per minute. The endpoint sends no X-Poll-Interval today; if
# it ever starts, that value is the server asking for a floor and wins over the
# configured interval.
set -uo pipefail

sha="${SHA:-$(git rev-parse HEAD)}"
interval="${CI_WAIT_INTERVAL:-1}"
etag=""
runs=""
announced=""
# The verdict itself lives in `checks-green` (CLOUD-346), by path rather than
# through mise so the bats suite exercises the same program without a mise
# process per poll. This task owns the POLL — the conditional request, the ETag,
# the interval — and nothing about what green means; that is one definition,
# shared with `auto-release-land.yml`, which used to carry a weaker copy.
verdict_of="$(dirname "$0")/checks-green"

# THE TWO PROGRESS SIGNALS (CLOUD-499), by path for the same reason
# `checks-green` is: a mise process per poll would cost more than the poll.
#
# This loop is the one place in a landing that iterates faster than the lease
# heartbeat, and until now it pushed nothing at all — `land` sets the phase
# `ci-wait(lap N)` once and it stays frozen for the whole matrix, so a heartbeat
# reading only the phase cannot tell a healthy wait from a wedged one. Two
# pushes, because the two failures are different: the TICK moves every poll and
# freezes when the loop stops turning, the SIG moves only when the check-runs do
# and freezes when the loop turns forever over a reading that will never
# resolve.
#
# Best-effort like every other registry write, and silent when
# `BATTEN_TASK_PID` is unset, which is every caller but `land`.
registry="$(dirname "$0")/task-registry"
polls=0
push_progress() { # <signature>
	[ -n "${BATTEN_TASK_PID:-}" ] || return 0
	"$registry" tick "$BATTEN_TASK_PID" "$polls" >/dev/null 2>&1 || true
	"$registry" sig "$BATTEN_TASK_PID" "$1" >/dev/null 2>&1 || true
}

echo "ci-wait: polling check-runs for $sha (conditional, ${interval}s)"

while :; do
	polls=$((polls + 1))
	# `?per_page=100`, because the default page is 30 and this endpoint returns a
	# check-run PER EVENT per name, not one per name (CLOUD-436). A nine-name
	# roster that has been readied, re-drafted and re-readied a few times, plus
	# the third parties, passes 30 rows without anything unusual happening — and
	# page 2 is never fetched here, so every row past the first 30 simply does
	# not exist as far as the verdict is concerned. Under the CLOUD-337
	# predicate a truncated name reads as ABSENT, so the failure mode is a
	# stall rather than a false green; it was a false green before that landed,
	# which is how it survived unnoticed. `checks-green`, `sonar-gate` and
	# `auto-bot-land.yml` all already ask for 100 — this was the one
	# reader that did not.
	args=(-i "repos/{owner}/{repo}/commits/$sha/check-runs?per_page=100")
	[ -n "$etag" ] && args+=(-H "If-None-Match: $etag")
	resp=$(gh api "${args[@]}" 2>/dev/null | tr -d '\r')

	status=$(printf '%s' "$resp" | sed -n '1s@^HTTP/[0-9.]* \([0-9]*\).*@\1@p')
	new_etag=$(printf '%s' "$resp" | sed -n 's/^[Ee][Tt]ag: //p' | head -n1)
	[ -n "$new_etag" ] && etag="$new_etag"

	server_floor=$(printf '%s' "$resp" | sed -n 's/^[Xx]-[Pp]oll-[Ii]nterval: //p' | head -n1)
	wait_for="$interval"
	if [ -n "$server_floor" ] && [ "$server_floor" -gt "$interval" ] 2>/dev/null; then
		wait_for="$server_floor"
	fi

	# 304: no body, nothing changed, keep the previous reading.
	if [ "$status" != "304" ]; then
		body=$(printf '%s' "$resp" | awk 'body {print} /^$/ {body=1}')
		runs=$(printf '%s' "$body" |
			jq -r '.check_runs[]? | "\(.status)\t\(.conclusion // "-")\t\(.name)\t\(.started_at // "")\t\(.id // 0)"' 2>/dev/null) || runs=""
		# Recomputed only where the reading can have changed. A 304 is the server
		# saying nothing moved, so re-hashing an unchanged string per poll would
		# be a fork spent to learn what the status line already said.
		runs_sig=$(printf '%s' "$runs" | cksum | tr -d ' ')
	fi
	# EVERY poll pushes, including the 304s: proving the loop turned is the tick's
	# whole job, and a poll that learned nothing still turned. The signature is
	# pushed on the same call and stamps itself only when it changes, so the pair
	# distinguishes "not turning" from "turning but going nowhere".
	push_progress "${runs_sig:-0}"

	# The reading this poll already holds, handed over rather than re-fetched:
	# `checks-green` makes no call of its own when $CHECKS_GREEN_RUNS is set, so
	# the conditional request above stays the only network here.
	answer=$(CHECKS_GREEN_RUNS="$runs" SHA="$sha" "$verdict_of" 2>&1)
	case $? in
	0)
		printf '%s\n' "$answer"
		echo "ci-wait: every required check terminal and green on $sha"
		exit 0
		;;
	1)
		printf '%s\n' "$answer" >&2
		exit 1
		;;
	2)
		printf '%s\n' "$answer" >&2
		exit 2
		;;
	esac

	# 3 — no answer yet. Say what is being waited on, once per change of answer.
	# Silence here is how a poll that will never resolve looks exactly like one
	# about to; repeating it every second is how the one that does gets scrolled
	# away.
	if [ -n "$answer" ] && [ "$answer" != "$announced" ]; then
		printf '%s\n' "$answer"
		announced="$answer"
	fi

	sleep "$wait_for"
done
