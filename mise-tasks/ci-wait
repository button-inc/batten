#!/usr/bin/env bash
#MISE description="Block until every check-run on HEAD reaches a terminal state, then report conclusions (exit 1 if any check did not succeed)"
#
# Workflow-contract step 4: after `gh pr ready`, CI is confirmed by a continuous
# poll, never by waiting on a webhook — webhooks drop successes, so silence is
# never green. `land` depends on this task, so a red PR cannot be landed. Run it
# backgrounded. Deliberately unbounded: the exit condition is "checks reached
# terminal", which always happens, and a wall-clock timeout would only
# reintroduce the VM-reap gap it was meant to close.
#
# The poll is conditional. Each request carries the previous response's ETag as
# `If-None-Match`; when nothing has changed GitHub answers 304 Not Modified with
# no body, and a 304 does not count against the rate limit. Measured here: three
# consecutive conditional requests left `X-RateLimit-Used` unchanged. That is
# what makes a short interval affordable — an unconditional 20s poll spent a
# request every 20s to usually learn nothing, so the interval had to stay long
# and the news arrived late.
#
# Terminality is decided over a NAMED REQUIRED SET, never over "any graded run"
# (CLOUD-327). The old predicate asked whether anything graded, when the question
# is whether the checks that judge this repository graded: `SonarCloud Code
# Analysis` and `release-plz` are not draft-gated, so the two of them satisfied it
# on their own and a set in which `ci`, `cross`, `commit-lint`, `darwin-link` and
# `final` were all `skipped` reported green. #261 landed on that.
#
# `skipped` is still not a bad conclusion, and deliberately: it is the intended
# economy for a draft and for a matrix leg that does not run, and refusing it
# everywhere is the CLOUD-247 stall this repo already paid for. What changed is
# WHERE it is read — a required check that skipped is not an answer and the poll
# continues (`land`'s lap re-fires the ready, which is what replaces the skips);
# an unrelated check that skipped is none of our business. The same scoping is
# why a third party cannot veto a landing: only a required check's failure is
# red here, matching what branch protection actually enforces.
#
# ABSENT is not the same as skipped, and must not be: `zizmor` is path-filtered,
# so on a PR touching no workflow it produces no check-run at all. Requiring every
# name to be PRESENT would hang forever on the ordinary PR. The predicate is
# therefore "at least one required check graded, none skipped, none pending".
#
# Measured against this endpoint: ~260ms network round trip warm, ~130ms of `gh`
# process startup, ~470ms for the whole conditional call. The sleep is therefore
# not what sets the pace — the round trip is — and a 1s interval gives a ~1.5s
# cycle, roughly 40 requests a minute against a secondary limit measured in
# hundreds of points per minute. The endpoint sends no X-Poll-Interval today; if
# it ever starts, that value is the server asking for a floor and wins over the
# configured interval.
set -uo pipefail

sha="${SHA:-$(git rev-parse HEAD)}"
interval="${CI_WAIT_INTERVAL:-1}"
etag=""
runs=""
announced=""
# Declared once in mise.toml [env] and read by `land` too. Unset is fatal rather
# than an empty set: an empty set makes every check unrequired, which is the
# false green this task exists to stop.
required="${CI_REQUIRED_CHECKS:?ci-wait: CI_REQUIRED_CHECKS is unset — run this through \`mise run ci-wait\`, which is where the required set is declared.}"

echo "ci-wait: polling check-runs for $sha (conditional, ${interval}s)"

while :; do
	args=(-i "repos/{owner}/{repo}/commits/$sha/check-runs")
	[ -n "$etag" ] && args+=(-H "If-None-Match: $etag")
	resp=$(gh api "${args[@]}" 2>/dev/null | tr -d '\r')

	status=$(printf '%s' "$resp" | sed -n '1s@^HTTP/[0-9.]* \([0-9]*\).*@\1@p')
	new_etag=$(printf '%s' "$resp" | sed -n 's/^[Ee][Tt]ag: //p' | head -n1)
	[ -n "$new_etag" ] && etag="$new_etag"

	server_floor=$(printf '%s' "$resp" | sed -n 's/^[Xx]-[Pp]oll-[Ii]nterval: //p' | head -n1)
	wait_for="$interval"
	if [ -n "$server_floor" ] && [ "$server_floor" -gt "$interval" ] 2>/dev/null; then
		wait_for="$server_floor"
	fi

	# 304: no body, nothing changed, keep the previous reading.
	if [ "$status" != "304" ]; then
		body=$(printf '%s' "$resp" | awk 'body {print} /^$/ {body=1}')
		runs=$(printf '%s' "$body" |
			jq -r '.check_runs[]? | "\(.status)\t\(.conclusion // "-")\t\(.name)"' 2>/dev/null) || runs=""
	fi

	# One pass over the required subset. `|`-separated because a tab is IFS
	# whitespace and `read` collapses runs of it, which would shift an empty
	# name list into the wrong variable; no check-run name contains a pipe.
	# Names are accumulated as pointers — a `<check> skipped` coordinate, never a
	# run's log (house-style §6).
	verdict=$(printf '%s\n' "$runs" | awk -F'\t' -v req="$required" '
		BEGIN { n = split(req, a, ","); for (i = 1; i <= n; i++) want[a[i]] = 1 }
		!NF || !($3 in want) { next }
		$1 != "completed" { pending++; next }
		$2 == "skipped" { skipped = skipped sep3 $3; sep3 = ", "; next }
		$2 == "success" || $2 == "neutral" { graded++; next }
		{ graded++; bad = bad sep4 $3 " " $2; sep4 = ", " }
		END { printf "%d|%d|%s|%s", graded + 0, pending + 0, skipped, bad }
	')
	IFS='|' read -r graded pending ungraded failed <<<"$verdict"

	if [ "$graded" -gt 0 ] && [ "$pending" -eq 0 ] && [ -z "$ungraded" ]; then
		printf '%s\n' "$runs" | awk -F'\t' 'NF {print $2"\t"$3}' | sort -u
		if [ -n "$failed" ]; then
			echo "::error:: CI is not green on $sha — $failed. Reproduce and fix locally." >&2
			exit 1
		fi
		echo "ci-wait: every required check terminal and green on $sha"
		exit 0
	fi

	# Say what is being waited on, once per change of answer. Silence here is how
	# a poll that will never resolve looks exactly like one about to.
	if [ -n "$ungraded" ] && [ "$ungraded" != "$announced" ]; then
		echo "ci-wait: not an answer yet on $sha — required check(s) skipped: $ungraded"
		announced="$ungraded"
	fi

	sleep "$wait_for"
done
