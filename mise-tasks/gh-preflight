#!/usr/bin/env bash
#MISE alias="ghp"
#MISE description="Probe the GitHub read endpoints this repo's tasks call, and declare the write claims they need — run it before trusting any GitHub result in a fresh environment"
#
# Why this is a command and not a comment.
#
# What GitHub claims our automation needs was written down only in prose (the
# proxy/token block in mise.toml). An under-scoped or proxy-substituted token
# therefore surfaces as an unrelated 403 at whichever task runs first — `ci-wait`
# reporting no checks, `land` unable to read PR state — each looking like its own
# unappealable denial rather than one missing claim.
#
# GitHub already answers the question, one endpoint at a time: a 403 carries
# `X-Accepted-GitHub-Permissions` naming exactly the claim that was missing. This
# walks the endpoints the tasks actually call and collects those answers, so
# "which claims do we need" is a command whose output cannot drift from the code.
#
# Read-only by construction. Only GET endpoints are probed. The write claims
# (landing, readying) are DECLARED and reported unverified, because the only way
# to test a write is to perform one — and merging a PR to find out whether you may
# merge a PR is not a diagnostic.
set -uo pipefail

# path|claim|used by|probe
ENDPOINTS=(
	"repos/{owner}/{repo}|metadata=read|every task that resolves the repo|yes"
	"repos/{owner}/{repo}/commits/HEAD/check-runs|checks=read|ci-wait (the whole poll)|yes"
	"repos/{owner}/{repo}/pulls?per_page=1|pull_requests=read|land (PR state, merged/closed)|yes"
	"repos/{owner}/{repo}/actions/runs?per_page=1|actions=read|land (the bot's refusal, read as a workflow-run conclusion — NOT a check-run on the PR head, which is where it never appears; CLOUD-235), and reading a failing job's logs after a red ci-wait|yes"
	"repos/{owner}/{repo}/issues/1/comments|pull_requests=write|land (posting /fast-forward)|no"
	"repos/{owner}/{repo}/pulls/1|pull_requests=write|gh pr ready — marking a draft ready is what starts CI here|no"
)

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
if [ -z "$repo" ]; then
	echo "::error:: could not resolve owner/repo — is gh authenticated? (GH_TOKEN comes from mise.toml [env])" >&2
	exit 2
fi
echo "gh-preflight: $repo"

login=$(gh api user --jq .login 2>/dev/null)
if [ -n "$login" ]; then
	echo "token   present, authenticated as $login"
else
	# A repo-scoped proxy token authenticates for repo reads while GET /user 401s;
	# that is informative, not fatal.
	echo "token   no user identity (a repo-scoped or proxy-injected token does this)"
fi
echo

missing=()
stale=()
for e in "${ENDPOINTS[@]}"; do
	IFS='|' read -r path claim used_by probe <<<"$e"
	path=${path//\{owner\}\/\{repo\}/$repo}

	if [ "$probe" != "yes" ]; then
		printf 'decl %-20s %s  (write — declared, never probed)\n' "$claim" "$path"
		continue
	fi

	head=$(gh api -i "$path" 2>/dev/null | tr -d '\r')
	status=$(printf '%s' "$head" | sed -n '1s@^HTTP/[0-9.]* \([0-9]*\).*@\1@p')
	case "$status" in
	2*)
		printf 'ok   %-20s %s\n' "$claim" "$path"
		;;
	403)
		named=$(printf '%s' "$head" | sed -n 's/^[Xx]-[Aa]ccepted-[Gg]it[Hh]ub-[Pp]ermissions: //p' | head -n1)
		printf 'MISS %-20s %s\n' "$claim" "$path"
		printf '     %-20s needed by: %s\n' "" "$used_by"
		missing+=("$claim")
		if [ -n "$named" ]; then
			printf '     %-20s GitHub names: %s\n' "" "$named"
			# If GitHub asks for something this table does not declare, GitHub is the
			# authority and the table is stale.
			[ "$named" = "$claim" ] || stale+=("$path -> GitHub wants $named, we declare $claim")
		fi
		;;
	*)
		# A 404 can mean an empty repo rather than a permission problem, so it is
		# reported without being counted as missing.
		printf '?    %-20s %s  (HTTP %s)\n' "$claim" "$path" "${status:-no response}"
		;;
	esac
done

echo
if [ "${#stale[@]}" -gt 0 ]; then
	echo "This table is STALE — GitHub asked for a claim it does not declare:"
	printf '  %s\n' "${stale[@]}"
	echo
fi
if [ "${#missing[@]}" -eq 0 ]; then
	echo "gh-preflight: every probed read endpoint answered. The write claims above are declared, not tested — a write cannot be probed without performing it."
	exit 0
fi
printf '::error:: missing %s read claim(s): %s\n' "${#missing[@]}" "$(printf '%s ' "${missing[@]}")" >&2
echo "These are permissions, not egress policy: plain repo reads succeed while these do not. Until they are granted, ci-wait cannot see CI state and land cannot see the merge." >&2
exit 1
