#!/usr/bin/env bash
#MISE description="Reclaim superseded build artifacts, and refuse below a measured disk floor — pointer-only, no build, no network"
#
# CLOUD-766. Cargo keys every artifact on a metadata hash and never reclaims a
# superseded one. A `land` lap rebases, which mints a new SHA, which changes the
# hash, which writes a fresh copy of every integration test binary while all
# previous copies stay. Growth is monotonic and nothing bounded it.
#
# MEASURED 2026-08-20, on a session that landed three issues:
#
#   target/                                        26 GB
#   files over 40 MB in target/debug/deps         283, totalling 16.6 GB
#   distinct integration-test stems               ~41
#   copies retained per stem                        6   (`batten` itself: 22)
#   reclaimable with no rebuild cost              13.2 GB across 237 files
#
# `[profile.dev] debug = 1` is the constant: it makes each copy ~100 MB rather
# than ~10 MB. Lowering it shrinks the constant and leaves the growth monotonic,
# which is why this reclaims instead.
#
# WHY THIS IS NOT `cargo clean`, and the distinction is the whole task. `clean`
# takes the caches too — `incremental` and the cross-target dirs — and those
# REGROW, so a session that cleans pays a full rebuild and is back at the wall a
# lap or two later. Measured: that happened twice before this task existed. The
# superseded artifacts never regrow once deleted, and they are where the bulk is.
# So the rule is "keep what the next build will read, delete what it will not",
# never "delete everything and rebuild".
#
# K=2 RATHER THAN 1, and it is a hedge with a stated cost. The newest artifact
# per stem is what the current build reads; the one before it is what a rebase
# that reverts — or a `git checkout` back to the previous SHA — would otherwise
# rebuild from scratch. Keeping two costs one extra copy per stem and buys back
# the common undo. Keeping one would be tighter and would make every reverted
# lap pay a full rebuild.
#
# WHY THE FLOOR IS CHECKED AFTER PRUNING. A tree that is over budget but prunable
# is not a problem, it is this task's ordinary case. Refusing first would turn
# every third lap into a stop for a condition the next four lines fix.
#
# WHAT THE REFUSAL IS FOR (the second half of CLOUD-766). Exhaustion does not
# announce itself as a disk problem. It arrives as:
#
#   rustc-LLVM ERROR: IO failure on output stream: No space left on device
#   # bats warning: Executed 61 instead of expected 2181 tests
#
# under a `land` line that says "verify failed on <sha> — reproduce and fix
# locally", which sends an author after a defect in their own diff that does not
# exist. That is CLOUD-727's class from a different cause. A named refusal here,
# before anything is spent, is what stops the misattribution.
#
# Pointer-only per non-negotiable rule 4: a file count, bytes, and the floor.
# Never a path listing — that is unbounded, and a caller who wants one can run
# `du`.
#
# Exit 0 pruned or nothing to prune / 1 below the floor after pruning / 2 could
# not look.
#
# The mutation drops the K-retention so every copy but the newest goes, which
# reads as a working prune and silently makes each reverted lap a full rebuild.
#MUTANT prune-keeps-no-spare|s/^KEEP=2$/KEEP=1/|the previous build is kept, so a reverted lap is not a full rebuild
# And the floor comparison, which is the half that turns exhaustion into a named
# refusal rather than a rustc error inside a test run.
#MUTANT floor-never-refuses|s/^\tif \[ "\$free_mb" -lt "\$FLOOR_MB" \]; then$/\tif false; then/|a tree still below the floor after pruning is refused
set -uo pipefail

# THE FLOOR AND THE MEASUREMENT THAT JUSTIFIES IT, on one line, in the form
# `timeout-check` uses for workflow jobs and `mcp-timeout-budget` for the MCP
# startup budget (CLOUD-266). Parsed below rather than merely readable, so the
# enforced number and its basis cannot drift apart.
#
# 4096 rather than a round guess: one `verify` lap's peak growth measured at
# ~1.5-2 GB, and the floor is twice the worst observed lap so a lap that starts
# above it can finish.
KEEP=2
FLOOR_MB=4096 # budget: worst-lap=2048mb x2 measured=2026-08-20

root="${TARGET_PRUNE_ROOT:-target}"
# The file the budget line is parsed out of, so a fixture can exercise the
# arithmetic without editing this file.
budget_file="${TARGET_PRUNE_BUDGET:-${BASH_SOURCE[0]}}"

while [ $# -gt 0 ]; do
	case "$1" in
	# `shift 2` on a lone flag shifts nothing and returns non-zero. Explicit
	# arity, asserted under `timeout` in the suite: a gate that hangs never
	# reports, and `verify` waits on this one.
	--root)
		if [ $# -lt 2 ] || [ -z "$2" ]; then
			echo "::error:: target-prune: --root needs a directory" >&2
			exit 2
		fi
		root="$2"
		shift 2
		;;
	*)
		echo "usage: target-prune [--root <dir>]" >&2
		exit 2
		;;
	esac
done

if [ ! -r "$budget_file" ]; then
	echo "::error:: target-prune: cannot read $budget_file to check the floor's own budget comment" >&2
	exit 2
fi
budget_line=$(grep -m1 -E '^FLOOR_MB=' "$budget_file")
budget_re='^FLOOR_MB=([0-9]+)[[:space:]]#[[:space:]]budget:[[:space:]]worst-lap=([0-9]+)mb[[:space:]]x([0-9]+)[[:space:]]measured=[0-9]{4}-[0-9]{2}-[0-9]{2}$'
if [[ ! $budget_line =~ $budget_re ]]; then
	echo "::error:: target-prune: the retention carries no parsable budget comment — a limit with no recorded measurement is the boilerplate CLOUD-266 refuses" >&2
	echo "  want FLOOR_MB=<mb> # budget: worst-lap=<mb>mb x<n> measured=YYYY-MM-DD" >&2
	exit 1
fi
FLOOR_MB="${BASH_REMATCH[1]}"
budget_worst="${BASH_REMATCH[2]}"
budget_multiplier="${BASH_REMATCH[3]}"
if [ "$FLOOR_MB" -ne $((budget_worst * budget_multiplier)) ]; then
	echo "::error:: target-prune: the floor disagrees with the basis it declares" >&2
	echo "  floor $FLOOR_MB" >&2
	echo "  basis $budget_worst x$budget_multiplier = $((budget_worst * budget_multiplier))" >&2
	exit 1
fi

# NO `target/` IS "could not look", never "nothing to prune". A caller in the
# wrong directory must not read as a clean tree — that is the silent false green
# this repository treats as worse than no gate.
if [ ! -d "$root" ]; then
	echo "::error:: target-prune: no build directory at $root — nothing was examined, and that is not the same as nothing to prune" >&2
	exit 2
fi

# ONLY UNDER `deps`, and only regular files. Everything else in `target/` is
# either a cache that regrows (so deleting it costs a rebuild) or a live
# artifact addressed by a stable name.
#
# The stem is the filename with cargo's `-<hash>` suffix removed, which is what
# groups the copies of one binary. `.d`, `.rlib`, `.rmeta` and friends are left
# alone: they are small, and a dangling one only makes cargo rebuild.
pruned=0
bytes=0
while IFS= read -r dir; do
	[ -d "$dir" ] || continue
	# Newest first, so `tail -n +K+1` is everything past the ones we keep.
	# `find -printf` sorts by mtime numerically rather than by `ls` parsing,
	# which SC2012 forbids and which is ambiguous for unusual filenames.
	while IFS= read -r stem; do
		[ -n "$stem" ] || continue
		while IFS= read -r victim; do
			[ -n "$victim" ] || continue
			size=$(stat -c %s "$victim" 2>/dev/null) || size=$(stat -f %z "$victim" 2>/dev/null) || size=0
			rm -f "$victim" || continue
			pruned=$((pruned + 1))
			bytes=$((bytes + size))
		done <<<"$(
			find "$dir" -maxdepth 1 -type f -perm -u+x -name "$stem-*" -printf '%T@ %p\n' 2>/dev/null |
				sort -rn | tail -n +$((KEEP + 1)) | cut -d' ' -f2-
		)"
	done <<<"$(
		find "$dir" -maxdepth 1 -type f -perm -u+x -printf '%f\n' 2>/dev/null |
			sed -E 's/-[0-9a-f]{8,}$//' | sort -u
	)"
done <<<"$(find "$root" -type d -name deps 2>/dev/null)"

reclaimed_mb=$((bytes / 1024 / 1024))
free_mb=$(df -Pm "$root" 2>/dev/null | awk 'NR==2{print $4}') || free_mb=""
if [ -z "$free_mb" ]; then
	echo "::error:: target-prune: could not read free space for $root" >&2
	exit 2
fi

echo "target-prune: $pruned superseded artifact(s) removed, ${reclaimed_mb}MB reclaimed, ${free_mb}MB free (floor ${FLOOR_MB}MB)"

# THE FLOOR, AFTER PRUNING. Still short here means the tree is not the problem —
# something else on the volume is — and the caller needs to know that BEFORE it
# spends a build, not as a rustc error two minutes in.
if [ "$free_mb" -lt "$FLOOR_MB" ]; then
	echo "::error:: target-prune: below the measured disk floor with nothing left to reclaim" >&2
	echo "  free ${free_mb}MB" >&2
	echo "  floor ${FLOOR_MB}MB" >&2
	echo "  A build started here fails as a rustc IO error inside a test run, which reads as a suite regression rather than a full disk. Free space outside $root, or start a fresh session." >&2
	exit 1
fi
exit 0
