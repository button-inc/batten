#!/usr/bin/env bash
#MISE description="Gate: the always-loaded context (AGENTS.md + any always-load memory) fits the token budget"
#
# The cost of AGENTS.md is not its line count, it is the tokens every agent pays
# on every turn whether or not a word of it applies. Memories are the release
# valve — read at a trigger, paid for only by the session that hits it — so a
# section moved out of AGENTS.md into a rarely-read memory is a real reduction.
# A section moved into a memory that every session ends up reading anyway is not,
# which is why anything always-loaded is counted here TOGETHER with AGENTS.md.
#
# Always-loaded set:
#   - AGENTS.md (CLAUDE.md is a symlink to it; counted once)
#   - .serena/memories/always/*.md, if that directory is ever created. Putting a
#     memory there is a declaration that every session reads it, and it then
#     costs exactly what an AGENTS.md section costs.
#
# Measured on the content that actually loads. Block-level HTML comments are
# stripped from a CLAUDE.md before it is injected, so a maintainer note costs
# nothing and must not count here; YAML frontmatter is stripped too. Counting raw
# bytes would tax the one construct that is already free.
#
# Two numbers, because the vendor guidance and the real cost are different
# things: lines against the documented target of 200 per CLAUDE.md (over that,
# adherence drops — the file still loads in full, nothing is truncated), and
# estimated tokens against the budget, which is what every agent actually pays.
#
# Tokens are estimated at 4 chars/token. It is an approximation, deliberately:
# an exact count needs a tokenizer, a model-specific vocabulary and a network
# fetch, and a budget gate that can fail because a download failed is worse than
# one that is 10% out. The estimate is stable, offline and monotonic — which is
# all a budget needs.
set -uo pipefail

budget="${BATTEN_CONTEXT_BUDGET:-3500}"

# Everything the loader drops before the content reaches context.
strip_unloaded() {
	perl -0777 -pe 's/^---\n.*?\n---\n//s; s/^<!--.*?-->\n?//gms' "$1"
}

total_chars=0
total_lines=0
report=""
while IFS= read -r f; do
	[ -f "$f" ] || continue
	loaded=$(strip_unloaded "$f")
	c=$(printf '%s' "$loaded" | wc -c | tr -d ' ')
	l=$(printf '%s\n' "$loaded" | wc -l | tr -d ' ')
	total_chars=$((total_chars + c))
	total_lines=$((total_lines + l))
	report+=$(printf '\n  %-34s %4d lines %6d chars  ~%5d tokens' "$f" "$l" "$c" "$((c / 4))")
done < <(
	echo "AGENTS.md"
	ls .serena/memories/always/*.md 2>/dev/null
)

tokens=$((total_chars / 4))
printf 'always-loaded context:%s\n' "$report"
printf '  %-34s %4d lines  %6d chars  ~%5d tokens  (budget %d)\n' "TOTAL" "$total_lines" "$total_chars" "$tokens" "$budget"
line_target="${BATTEN_CONTEXT_LINE_TARGET:-200}"
if [ "$total_lines" -ge "$line_target" ]; then
	echo "::error:: always-loaded context is $total_lines lines, at or over the documented $line_target-line target for a CLAUDE.md. Nothing is truncated — the file loads in full — but adherence drops with length. Move a section behind an index (see 'Where the rest lives')." >&2
	exit 1
fi

if [ "$tokens" -gt "$budget" ]; then
	cat >&2 <<EOF
::error:: always-loaded context is ~$tokens tokens, over the $budget budget.

Every agent pays this on every turn. Cut, or move a section to a Serena memory
that is read at a trigger — see the sorting rule in
mem:prior-art-and-issue-hygiene. Moving it under .serena/memories/always/ does
not help: that directory counts here too, by design.
EOF
	exit 1
fi

printf 'context-budget: ~%d tokens, %d under budget\n' "$tokens" "$((budget - tokens))"
