#!/usr/bin/env bash
#MISE description="Effect: render the CLI reference from the command surface — the publish-time artifact, never committed (CLOUD-171)"
#
# CLOUD-171. A hand-written reference to a machine-readable surface is a second
# authority for the same facts, and goes stale silently. CLOUD-69 built the
# renderer — `batten generate markdown` walks the same SURFACE-built clap tree
# the parser is built from, and carries the §5 effect column no external
# renderer knows about — and deliberately left this format as the one it did NOT
# commit. This is the other half: the command that turns the renderer into a
# published artifact.
#
# NOTHING GENERATED IS COMMITTED, and that is the whole design rather than an
# omission. `completions/` and `man/` are committed because a packager installs
# them from the tree, so they need `derived-check` diffing them byte-for-byte
# against their generator. The reference has no such consumer: it is rendered
# from the released binary at publish time, which makes it current by
# construction — there is no second copy, so there is nothing to drift, and no
# drift gate to write. `tests/surface.rs`'s `the_markdown_reference_is_not_committed`
# asserts the absence, naming this exact path, because nothing else would notice
# somebody adding a convenience copy.
#
# `no-docs-tree` is therefore not in the way twice over: it fails on TRACKED
# `docs/` paths, and this is neither tracked nor under `docs/`.
#
# THE RENDERER NEEDS NO `[tools]` PIN. It is `batten` itself, in this tree since
# CLOUD-69, so there is no entry to add and therefore no `mise.lock` entry to
# forget — the failure mode `[settings] lockfile = false` sets up, where an
# unlocked tool installs fine locally forever and dies at CI's install step.
#
#   mise run render:cli            # render it
#   mise run render:cli --names    # what it is called, with no build
#
# Prints `reference=<path>` — KEY=VALUE, the same shape `mise-tasks/dist`
# (`archive=`/`binary=`), `mise-tasks/sbom` (`spdx=`/`cdx=`) and
# `mise-tasks/checksums` (`sums=`) already use, so the release workflow appends
# it to `$GITHUB_OUTPUT` unchanged and the asset path is decided in one file
# rather than re-derived in YAML.
#
# Exit 0 rendered / 1 could not render.
set -euo pipefail

# The asset name a consumer downloads. One authority: `release-assets-check`
# asks `--names` rather than spelling it a second time, the way it already asks
# `sbom --names` and `checksums --names`.
readonly REFERENCE=batten-cli-reference.md

# Where it lands. Overridable so a caller can stage it elsewhere; git-ignored
# either way, like `dist/`, `sbom/` and `checksums/`.
OUT_DIR="${RENDER_CLI_OUT_DIR:-reference}"
OUT="${OUT_DIR}/${REFERENCE}"

# Answered before anything is built and before any network, so a gate can ask
# from any directory and pay nothing for the answer.
if [ "${1:-}" = "--names" ]; then
	echo "reference=$OUT"
	exit 0
fi

if [ "$#" -gt 0 ]; then
	echo "::error:: render:cli takes no arguments (or --names); got: $*" >&2
	exit 1
fi

mkdir -p "$OUT_DIR"

# Rendered into a scratch file and moved into place only on success. A failed
# render that had already truncated the target would leave a zero-byte file that
# every later step treats as an artifact — and the publish step would upload it.
scratch=$(mktemp)
trap 'rm -f "$scratch"' EXIT

# `cargo run` rather than an installed binary, for the reason `mise run
# completions` and `mise run man` use it: the artifact must track the surface of
# the tree being published, and those are the pair a release ships together.
if ! cargo run --quiet -p batten -- generate markdown >"$scratch"; then
	echo "::error:: render:cli: the binary could not render the reference" >&2
	exit 1
fi

# A renderer that succeeds and emits nothing is the failure a publish step
# cannot see: an empty file uploads exactly as well as a full one.
if [ ! -s "$scratch" ]; then
	echo "::error:: render:cli: the reference rendered empty; refusing to publish a file that says nothing" >&2
	exit 1
fi

mv "$scratch" "$OUT"
trap - EXIT

echo "reference=$OUT"
