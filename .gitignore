/target
**/*.rs.bk
*.pdb

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code: the project settings.json is shared with the team, so force-track
# it — this overrides a common per-user global ignore of `.claude/` (repo
# .gitignore has higher precedence than core.excludesFile). Everything else under
# .claude stays ignored: per-user overrides (settings.local.json), the worktree
# copies, and scratch dirs.
# Claude Code: the whole project `.claude/` config is shared with the team
# (settings.json, agents/, skills/, commands/, rules/, hooks/, …). Force-track it
# past a common per-user global ignore of `.claude/` — repo .gitignore outranks
# core.excludesFile, same as the .serena/ block above. Only per-user,
# machine-local, and scratch paths are re-ignored below.
!.claude/
**/.claude/settings.local.json
.claude/history/
/.claude/worktrees/
/.claude/.cc-writes/
# The session transcript symlink `[transcript]` in batten.toml names (CLOUD-97).
# Refreshed per turn by mise-tasks/stop-guard.sh from the Stop payload; committing
# it would put a whole session's prose in the tree.
/.claude/.transcript.jsonl

# Per-user local Claude memory — never shared (personal overrides of CLAUDE.md).
CLAUDE.local.md

# Serena semantic-code config is shared with the whole team. Force-track it here:
# this overrides a common per-user global ignore of `.serena` (higher precedence
# than core.excludesFile). Only the per-machine cache and local overrides stay
# ignored — see also .serena/.gitignore.
!.serena/
.serena/cache/
.serena/project.local.yml

# Raise-only local config override (§8) — never committed.
batten.local.toml

# Distribution archives built by `mise run dist` — never committed (CLOUD-173).
/dist/

# SBOMs derived by `mise run sbom` — cut from the tagged source at release time and
# attached to the release, never committed (CLOUD-262).
/sbom/

# The checksum manifest derived by `mise run checksums` — hashed from a release's
# own assets after upload and attached to it, never committed (CLOUD-278).
/checksums/

# The CLI reference rendered by `mise run render:cli` — derived from the command
# surface at publish time and attached to the release, never committed
# (CLOUD-171). This entry is what makes "never committed" structural rather than
# a promise: a reference derived at publish time is current by construction, and
# a committed copy would be the second authority the whole design removes.
/reference/

# Fuzz build output and the machine's working corpus (CLOUD-112). The curated
# seeds under fuzz/corpus/ and any saved reproducer under fuzz/artifacts/ ARE
# tracked — the replay gate reads them — but the sanitizer-instrumented target
# dir and libFuzzer's own coverage-expanding working set are build output.
fuzz/target/
fuzz/work/
__pycache__/
