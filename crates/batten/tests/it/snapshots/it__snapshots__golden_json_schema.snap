        },
        {
          "name": "command",
          "short": null,
          "long": null,
          "takes_value": true,
          "positional": true,
          "help": "The command to run, after `--`, with its own arguments intact"
        },
        {
          "name": "continue_on_error",
          "short": null,
          "long": "continue-on-error",
          "takes_value": false,
          "positional": false,
