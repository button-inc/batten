            },
            {
              "name": "dry_run",
              "short": "n",
              "long": "dry-run",
              "takes_value": false,
              "positional": false,
              "help": "Preview what would be applied, writing nothing"
            }
          ],
          "subcommands": []
        }
      ]
    },
