---
{
  "path": "batten",
  "about": "Agent-era completion gate: repo-state conformance checks enforced at the agent's tool call.",
  "effect": "ask",
  "flags": [
    {
      "name": "config_from",
      "short": null,
      "long": "config-from",
      "takes_value": true,
      "help": "Read the committed config from a git ref (e.g. origin/main) instead of the working tree"
    },
    {
      "name": "config_in",
      "short": null,
      "long": "config-in",
      "takes_value": true,
      "help": "Read the committed config from this directory instead of the directory being judged"
    },
    {
      "name": "debug",
      "short": null,
      "long": "debug",
      "takes_value": false,
      "help": "Add resolution detail"
    },
    {
      "name": "fail_on_warning",
      "short": null,
      "long": "fail-on-warning",
      "takes_value": false,
      "help": "Promote a warn-severity finding to a violation (an override may only turn this on)"
    },
    {
      "name": "log_level",
      "short": null,
      "long": "log-level",
      "takes_value": true,
      "help": "Set the verbosity rung by name"
    },
    {
      "name": "no_color",
      "short": null,
      "long": "no-color",
      "takes_value": false,
      "help": "Never colour stderr, whatever it is attached to"
    },
    {
      "name": "no_input",
      "short": null,
      "long": "no-input",
      "takes_value": false,
      "help": "Never prompt; treat the run as unattended"
    },
    {
      "name": "quiet",
      "short": "q",
      "long": "quiet",
      "takes_value": false,
      "help": "Suppress ordinary progress (repeatable: -qq is silent)"
    },
    {
      "name": "silent",
      "short": null,
      "long": "silent",
      "takes_value": false,
      "help": "Say nothing but a verdict or a usage error"
    },
    {
      "name": "strictness",
      "short": null,
      "long": "strictness",
      "takes_value": true,
      "help": "Raise how strictly gates apply (an override may only tighten policy)"
    },
    {
      "name": "trace",
      "short": null,
      "long": "trace",
      "takes_value": false,
      "help": "Add everything"
    },
    {
      "name": "verbose",
      "short": "v",
      "long": "verbose",
      "takes_value": false,
      "help": "Explain what is being checked (repeatable: -vv is debug)"
    },
    {
      "name": "yes",
      "short": "y",
      "long": "yes",
      "takes_value": false,
      "help": "Confirm a destructive operation that would otherwise refuse"
    }
  ],
  "subcommands": [
