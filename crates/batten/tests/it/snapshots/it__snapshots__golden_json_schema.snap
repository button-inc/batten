            {
              "name": "harness",
              "short": null,
              "long": "harness",
              "takes_value": true,
              "help": "Report the attribution capabilities this host declares, and capture at that fidelity"
            },
            {
              "name": "json",
              "short": "J",
              "long": "json",
              "takes_value": false,
              "help": "Emit byte-stable JSON instead of pointer lines"
            },
            {
              "name": "message",
              "short": null,
              "long": "message",
              "takes_value": true,
