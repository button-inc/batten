{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["serena"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "mise run -q contract-drift"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise run -q contract-drift"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise run -q mcp-attach-check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise run -q stop-guard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mise run gh-guard"
          },
          {
            "type": "command",
            "command": "mise run ready-guard"
          },
          {
            "type": "command",
            "command": "mise run issue-guard"
          },
          {
            "type": "command",
            "command": "mise run run-shape-guard"
          },
          {
            "type": "command",
            "command": "mise run memory-guard"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mise run memory-guard"
          },
          {
            "type": "command",
            "command": "mise run claim-guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(mise:*)",
      "mcp__Linear",
      "mcp__Linear__*",
      "mcp__claude_ai_Linear__*",
      "mcp__serena__*",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_sessions"
    ],
    "deny": [
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger"
    ]
  }
}
