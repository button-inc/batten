{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      },
      {
        "matcher": ".*save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/issue-search-guard"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/issue-read-guard"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/board-move-guard"
          }
        ]
      },
      {
        "matcher": ".*(subscribe_pr_activity|send_later|create_trigger)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/connector-verb-guard"
          }
        ]
      },
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/connector-allow-guard"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/fanout-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      },
      {
        "matcher": ".*save_issue|.*save_comment",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/board-write-record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/stop-guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/contract-drift"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/batten-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/mcp-attach-check"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/mise-tasks/mcp-allow-check --session"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(mise:*)",
      "mcp__Linear",
      "mcp__Linear__*",
      "mcp__Linear__get_issue",
      "mcp__serena__*",
      "mcp__github__unsubscribe_pr_activity"
    ],
    "deny": [
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__github__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__subscribe_pr_activity"
    ]
  }
}
