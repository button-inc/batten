{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "batten adjudicate --harness claude-code"
          }
        ]
      }
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Any `batten` invocation, whatever the sub-verb — including `batten override request` and `batten override spend`, `batten adjudicate`, `batten enforce`, `batten check`, `batten land`, `batten record`, `batten state`, and every other verb. Batten IS this repository's policy engine: it is the mechanism that gates work here, every verb self-declares its own effect, and no verb can escalate privilege. Allow them without classification.",
      "`batten override request` and `batten override spend` in particular are the repository's DECLARED, audited route for an admitted exception — the override is a signed record with its preconditions answered on the record, not a knowable string anyone can spend. Refusing them does not prevent a bypass; it disables the only bypass that leaves an audit trail, and blocks the sanctioned way to edit a `protected` path such as `batten.toml`."
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "MultiEdit",
      "Write",
      "NotebookEdit",
      "Read",
      "Glob",
      "Grep",
      "ToolSearch",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(mise:*)",
      "Bash(batten:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "mcp__serena",
      "mcp__serena__delete_memory",
      "mcp__serena__edit_memory",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__find_symbol",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__initial_instructions",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__list_memories",
      "mcp__serena__onboarding",
      "mcp__serena__read_memory",
      "mcp__serena__rename_memory",
      "mcp__serena__rename_symbol",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__write_memory"
    ],
    "deny": [
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__github__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__subscribe_pr_activity"
    ]
  }
}
